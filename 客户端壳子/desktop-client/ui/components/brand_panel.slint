export component BrandPanel inherits Rectangle {
    in property <string> product-name: "一键开整";
    in property <string> status-copy: "你的电子牛马已就位。";
    in property <string> launch-copy: "少折腾，直接开工。";
    in property <string> hero-title: "欢迎王者归来";
    in property <string> hero-subtitle: "精编引擎。极简，极速，极度专注。";

    background: transparent;

    // Hero Title - large gradient text effect (simulated with primary color)
    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.hero-title;
        color: #006499;
        font-size: 42px;
        font-weight: 900;
        wrap: word-wrap;
    }

    // Subtitle
    Text {
        x: 0px;
        y: 60px;
        width: parent.width;
        text: root.hero-subtitle;
        color: #596064;
        font-size: 18px;
        font-weight: 500;
        wrap: word-wrap;
    }
}
