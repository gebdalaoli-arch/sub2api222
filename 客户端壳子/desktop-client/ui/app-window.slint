import { Button } from "std-widgets.slint";
import { BrandPanel } from "components/brand_panel.slint";
import { AnnouncementCenterScreen } from "screens/announcements.slint";
import { ForgotPasswordScreen } from "screens/forgot_password.slint";
import { HelpDetailScreen } from "screens/help_detail.slint";
import { LaunchPanel } from "screens/launch_panel.slint";
import { LoginScene } from "screens/login_scene.slint";
import { RedeemScreen } from "screens/redeem.slint";
import { LoginScreen } from "screens/login.slint";
import { OverviewScreen } from "screens/overview.slint";
import { RegisterPanel } from "screens/register_panel.slint";
import { UpdateDialog } from "screens/update_dialog.slint";

export component AppWindow inherits Window {
    width: 1280px;
    height: 860px;
    title: "一键开整";
    background: #f7f9fb;
    default-font-family: "Inter, Microsoft YaHei UI";

    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <string> reset-token;
    in-out property <string> new-password;

    in-out property <bool> desktop-available: false;
    in-out property <bool> cli-available: false;
    in-out property <string> launch-status-text: "尚未检测 Codex 安装";
    in-out property <string> auth-status-text: "请先登录以启用平台模式与账户同步。";
    in-out property <string> reset-status-text: "可先发送重置邮件，再填写邮件中的重置码。";
    in-out property <string> dashboard-user-label: "当前账号：未登录";
    in-out property <string> dashboard-balance-text: "余额：--";
    in-out property <string> dashboard-usage-text: "并发额度：--";
    in-out property <string> dashboard-account-status-text: "账户状态：待登录";
    in-out property <string> dashboard-notice-text: "充值页当前作为公告区。首版优先支持 CDK 兑换、订阅状态查看和平台模式启动。";
    in-out property <bool> remember-password: true;
    in-out property <bool> auto-login: false;
    in-out property <bool> show-login-totp: false;
    in-out property <bool> session-active: false;
    in-out property <int> auth-subview: 0;
    in-out property <string> brand-status-copy: "你的电子牛马已就位。";
    in-out property <string> redeem-code;
    in-out property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in-out property <string> subscription-summary-text: "暂无订阅摘要";
    in-out property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in-out property <[string]> order-lines: ["最近订单会显示在这里。"];
    in-out property <[string]> redeem-history-lines: ["最近兑换记录会显示在这里。"];
    in-out property <int> current-section: 0;
    in-out property <[string]> launch-group-options: ["登录后加载可用分组"];
    in-out property <int> launch-selected-group-index: 0;
    in-out property <bool> launch-cli-mode: false;
    in-out property <bool> update-dialog-visible: false;
    in-out property <bool> update-force: false;
    in-out property <string> update-current-version: "v0.1.0";
    in-out property <string> update-latest-version: "v0.2.0";
    in-out property <string> update-summary: "修复若干问题，并带来更稳定的一键开整体验。";

    callback refresh-installations-requested();
    callback launch-desktop-requested();
    callback launch-cli-requested();
    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback login-requested();
    callback register-requested();
    callback verify-code-requested();
    callback forgot-password-requested();
    callback reset-password-requested();
    callback redeem-requested();
    callback manual-update-check-requested();
    callback update-primary-requested();
    callback update-secondary-requested();

    // ═══════════════════════════════════════════
    // Layout constants from Stitch design:
    // SideNavBar: w-64 = 256px, bg: surface-container-low (#f0f4f7)
    // TopAppBar: h-16 = 64px, bg: surface-container-lowest (#ffffff) 80% + blur
    // Main content: flex-1, p-8/p-12 = 32px/48px padding
    // ═══════════════════════════════════════════

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f7f9fb;

        // ═══ SideNavBar: 256px wide, full height ═══
        Rectangle {
            x: 0px; y: 0px;
            width: 256px;
            height: parent.height;
            background: #f0f4f7; // surface-container-low

            // ── User avatar area + brand ──
            Rectangle {
                x: 24px; y: 24px;
                width: 48px; height: 48px;
                background: #eaeff2;
                border-radius: 24px;
            }

            Text {
                x: 80px; y: 28px;
                text: "一键开整";
                color: #006499;
                font-size: 20px;
                font-weight: 900;
            }

            Text {
                x: 80px; y: 52px;
                text: "Windows 客户端";
                color: #51616b;
                font-size: 12px;
            }

            // ── Nav items ──
            // Active: bg white, text primary, shadow
            // Inactive: no bg, text tertiary, hover surface-container

            // Nav 0: 总览
            Rectangle {
                x: 24px; y: 96px;
                width: 208px; height: 44px;
                background: root.current-section == 0 ? #ffffff : transparent;
                border-radius: 8px;
                TouchArea { clicked => { root.current-section = 0; } }
                Text {
                    x: 44px; y: 12px;
                    text: "总览";
                    color: root.current-section == 0 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 0 ? 700 : 400;
                }
            }

            // Nav 1: 启动 Codex
            Rectangle {
                x: 24px; y: 144px;
                width: 208px; height: 44px;
                background: root.current-section == 1 ? #ffffff : transparent;
                border-radius: 8px;
                TouchArea { clicked => { root.current-section = 1; } }
                Text {
                    x: 44px; y: 12px;
                    text: "启动 Codex";
                    color: root.current-section == 1 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 1 ? 700 : 400;
                }
            }

            // Nav 2: 计费中心
            Rectangle {
                x: 24px; y: 192px;
                width: 208px; height: 44px;
                background: root.current-section == 2 ? #ffffff : transparent;
                border-radius: 8px;
                TouchArea { clicked => { root.current-section = 2; } }
                Text {
                    x: 44px; y: 12px;
                    text: "计费中心";
                    color: root.current-section == 2 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 2 ? 700 : 400;
                }
            }

            // Nav 3: 设置与帮助
            Rectangle {
                x: 24px; y: 240px;
                width: 208px; height: 44px;
                background: root.current-section == 3 ? #ffffff : transparent;
                border-radius: 8px;
                TouchArea { clicked => { root.current-section = 3; } }
                Text {
                    x: 44px; y: 12px;
                    text: "设置与帮助";
                    color: root.current-section == 3 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 3 ? 700 : 400;
                }
            }
        }

        // ═══ TopAppBar: h=64px, glass effect ═══
        Rectangle {
            x: 256px; y: 0px;
            width: parent.width - 256px;
            height: 64px;
            background: #ffffffcc; // 80% white, glass

            Text {
                x: 32px; y: 20px;
                text: "一键开整";
                color: #006499;
                font-size: 18px;
                font-weight: 700;
            }

            // Notification button
            Rectangle {
                x: parent.width - 56px; y: 16px;
                width: 32px; height: 32px;
                background: transparent;
                border-radius: 16px;
                TouchArea { clicked => { root.current-section = 4; } }
                Text { x: 6px; y: 6px; text: "🔔"; font-size: 16px; }
            }
        }

        // ═══ Main Content Area: below TopAppBar, right of SideNav ═══
        // x: 256px, y: 64px, padded 48px

        if root.current-section == 0: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            if root.session-active: OverviewScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                welcome-text: "准备开整";
                user-label: root.dashboard-user-label;
                balance-text: root.dashboard-balance-text;
                usage-text: root.dashboard-usage-text;
                account-status-text: root.dashboard-account-status-text;
                notice-text: root.dashboard-notice-text;
                open-launch-requested => { root.current-section = 1; }
                open-billing-requested => { root.current-section = 2; }
                open-help-requested => { root.current-section = 3; }
            }

            // ── Login flow (when not session-active, inline) ──
            if !root.session-active: BrandPanel {
                x: 0px; y: 0px;
                width: 320px;
                height: parent.height;
                product-name: "一键开整";
                status-copy: root.brand-status-copy;
            }

            if !root.session-active: LoginScreen {
                x: 360px; y: 0px;
                width: parent.width - 360px;
                email <=> root.email;
                password <=> root.password;
                verification-code <=> root.verification-code;
                remember-password <=> root.remember-password;
                auto-login <=> root.auto-login;
                show-totp-field: root.show-login-totp;
                status-text: root.auth-status-text;
                login-requested => { root.login-requested(); }
                open-register-requested => { root.auth-subview = 1; }
                open-forgot-password-requested => { root.auth-subview = 2; }
            }

            if !root.session-active && root.auth-subview == 1: RegisterPanel {
                x: 400px; y: 60px;
                width: parent.width - 420px;
                height: 480px;
                email <=> root.email;
                password <=> root.password;
                verification-code <=> root.verification-code;
                status-text: root.auth-status-text;
                register-submit-requested => { root.register-requested(); }
                verify-code-requested => { root.verify-code-requested(); }
                back-requested => { root.auth-subview = 0; }
            }

            if !root.session-active && root.auth-subview == 2: ForgotPasswordScreen {
                x: 400px; y: 60px;
                width: parent.width - 420px;
                height: 480px;
                email <=> root.email;
                reset-token <=> root.reset-token;
                new-password <=> root.new-password;
                status-text: root.reset-status-text;
                forgot-password-requested => { root.forgot-password-requested(); }
                reset-password-requested => { root.reset-password-requested(); }
                back-requested => { root.auth-subview = 0; }
            }
        }

        // ═══ Section 1: 启动 Codex (centered card layout) ═══
        if root.current-section == 1: Rectangle {
            x: 256px;
            y: 64px;
            width: parent.width - 256px;
            height: parent.height - 64px;
            background: #f7f9fb;

            LaunchPanel {
                x: (parent.width - 640px) / 2;
                y: 48px;
                width: 640px;
                height: parent.height - 96px;
                desktop-available: root.desktop-available;
                cli-available: root.cli-available;
                status-text: root.launch-status-text;
                group-options: root.launch-group-options;
                selected-group-index <=> root.launch-selected-group-index;
                cli-mode <=> root.launch-cli-mode;
                refresh-requested => { root.refresh-installations-requested(); }
                launch-platform-desktop-requested => { root.launch-platform-desktop-requested(); }
                launch-platform-cli-requested => { root.launch-platform-cli-requested(); }
            }
        }

        // ═══ Section 2: 计费详情 ═══
        if root.current-section == 2: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            RedeemScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                redeem-code <=> root.redeem-code;
                redeem-status-text: root.redeem-status-text;
                subscription-summary-text: root.subscription-summary-text;
                subscription-lines: root.subscription-lines;
                order-lines: root.order-lines;
                history-lines: root.redeem-history-lines;
                redeem-requested => { root.redeem-requested(); }
            }
        }

        // ═══ Section 3: 设置与帮助 ═══
        if root.current-section == 3: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            HelpDetailScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                manual-update-check-requested => { root.manual-update-check-requested(); }
            }
        }

        // ═══ Section 4: 公告中心 ═══
        if root.current-section == 4: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            AnnouncementCenterScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
            }
        }

        // ═══ Login Scene overlay (when !session-active, covers everything) ═══
        if !root.session-active: LoginScene {
            x: 0px; y: 0px;
            width: parent.width;
            height: parent.height;
            email <=> root.email;
            password <=> root.password;
            verification-code <=> root.verification-code;
            reset-token <=> root.reset-token;
            new-password <=> root.new-password;
            remember-password <=> root.remember-password;
            auto-login <=> root.auto-login;
            show-totp-field <=> root.show-login-totp;
            auth-subview <=> root.auth-subview;
            showing-announcements: root.current-section == 4;
            auth-status-text: root.auth-status-text;
            reset-status-text: root.reset-status-text;
            brand-status-copy: root.brand-status-copy;
            login-requested => { root.login-requested(); }
            register-requested => { root.register-requested(); }
            verify-code-requested => { root.verify-code-requested(); }
            forgot-password-requested => { root.forgot-password-requested(); }
            reset-password-requested => { root.reset-password-requested(); }
        }

        UpdateDialog {
            width: parent.width;
            height: parent.height;
            dialog-visible: root.update-dialog-visible;
            force-update: root.update-force;
            current-version: root.update-current-version;
            latest-version: root.update-latest-version;
            summary: root.update-summary;
            primary-requested => { root.update-primary-requested(); }
            secondary-requested => { root.update-secondary-requested(); }
        }
    }
}
