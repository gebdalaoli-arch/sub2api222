import { Button } from "std-widgets.slint";
import { AnnouncementCenterScreen } from "screens/announcements.slint";
import { BillingDetailScreen } from "screens/billing_detail.slint";
import { HelpDetailScreen } from "screens/help_detail.slint";
import { LaunchPanel } from "screens/launch_panel.slint";
import { LoginScene } from "screens/login_scene.slint";
import { OverviewScreen } from "screens/overview.slint";
import { SessionManagerScreen } from "screens/session_manager.slint";
import { UpdateDialog } from "screens/update_dialog.slint";
import { UsageDetailScreen } from "screens/usage_detail.slint";

export component AppWindow inherits Window {
    width: 1280px;
    height: 860px;
    title: "一键开整";
    background: #f7f9fb;
    default-font-family: "Inter, Microsoft YaHei UI";

    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <string> reset-token;
    in-out property <string> new-password;

    in-out property <bool> desktop-available: false;
    in-out property <bool> cli-available: false;
    in-out property <string> launch-status-text: "尚未检测 Codex 安装";
    in-out property <string> auth-status-text: "请先登录以启用平台模式与账户同步。";
    in-out property <string> reset-status-text: "可先发送重置邮件，再填写邮件中的重置码。";
    in-out property <string> dashboard-user-label: "当前账号：未登录";
    in-out property <string> dashboard-balance-text: "--";
    in-out property <string> dashboard-usage-text: "--";
    in-out property <string> dashboard-account-status-text: "账户状态：待登录";
    in-out property <string> dashboard-notice-text: "计费中心已支持余额、套餐、订单与兑换记录的统一查看。";
    in-out property <bool> remember-password: true;
    in-out property <bool> auto-login: false;
    in-out property <bool> auth-busy: false;
    in-out property <bool> show-login-totp: false;
    in-out property <bool> session-active: false;
    in-out property <int> auth-subview: 0;
    in-out property <string> brand-status-copy: "你的电子牛马已就位。";
    in-out property <string> redeem-code;
    in-out property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in-out property <string> billing-plan-title: "暂未开通订阅";
    in-out property <string> billing-balance-headline: "¥--";
    in-out property <string> billing-usage-caption: "登录后可查看余额与订单明细。";
    in-out property <string> subscription-summary-text: "暂无订阅摘要";
    in-out property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in-out property <[string]> subscription-detail-lines: ["暂无订阅明细。"];
    in-out property <[string]> order-lines: ["最近订单会显示在这里。"];
    in-out property <[string]> order-detail-lines: ["暂无订单明细。"];
    in-out property <[string]> redeem-history-lines: ["最近兑换记录会显示在这里。"];
    in-out property <string> billing-recharge-amount: "";
    in-out property <[string]> billing-payment-method-options: ["暂无可用支付方式"];
    in-out property <int> billing-selected-payment-method-index: 0;
    in-out property <[string]> billing-subscription-plan-options: ["暂无可用套餐"];
    in-out property <int> billing-selected-subscription-plan-index: 0;
    in-out property <string> billing-checkout-status-text: "支付创建后会在这里显示状态。";
    in-out property <string> usage-summary-title: "最近 0 条消费明细";
    in-out property <string> usage-total-requests-text: "0";
    in-out property <string> usage-total-tokens-text: "0";
    in-out property <string> usage-total-actual-cost-text: "¥0.000000";
    in-out property <[string]> usage-model-lines: ["暂无数据"];
    in-out property <[string]> usage-time-lines: ["暂无数据"];
    in-out property <[string]> usage-input-lines: ["0"];
    in-out property <[string]> usage-output-lines: ["0"];
    in-out property <string> usage-page-meta-text: "第 0 / 0 页";
    in-out property <[string]> usage-view-mode-options: ["按时间", "按模型"];
    in-out property <int> usage-selected-view-mode-index: 0;
    in-out property <string> usage-status-text: "登录后可查看消费明细。";
    in-out property <int> current-section: 0;
    in-out property <[string]> launch-group-options: ["登录后加载桌面客户端专用分组"];
    in-out property <int> launch-selected-group-index: 0;
    in-out property <bool> launch-cli-mode: false;
    in-out property <bool> update-dialog-visible: false;
    in-out property <bool> update-force: false;
    in-out property <string> update-current-version: "v0.1.0";
    in-out property <string> update-latest-version: "v0.2.0";
    in-out property <string> update-download-url: "";
    in-out property <string> update-summary: "修复若干问题，并带来更稳定的一键开整体验。";
    in-out property <string> announcement-hero-version: "最新动态";
    in-out property <string> announcement-hero-title: "公告中心已准备就绪";
    in-out property <string> announcement-hero-summary: "这里会展示系统更新、维护通知和使用提醒。";
    in-out property <[string]> announcement-version-lines: ["暂无版本动态"];
    in-out property <[string]> announcement-feed-lines: ["暂无系统公告"];
    in-out property <string> view-key-password: "";
    in-out property <string> view-key-status-text: "输入账户密码后，可生成一个 7 天有效的使用密钥并打开说明页。";
    in-out property <string> session-home-count-text: "0";
    in-out property <string> session-count-text: "0";
    in-out property <string> session-trash-count-text: "0";
    in-out property <string> session-status-text: "本地会话会显示在这里。";
    in-out property <[string]> session-group-lines: ["暂无工作区"];
    in-out property <int> session-selected-group-index: 0;
    in-out property <[string]> session-entry-lines: ["暂无会话"];
    in-out property <int> session-selected-entry-index: 0;
    in-out property <[string]> session-trash-lines: ["废纸篓为空"];
    in-out property <int> session-selected-trash-index: 0;

    callback refresh-installations-requested();
    callback launch-desktop-requested();
    callback launch-cli-requested();
    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback login-requested();
    callback register-requested();
    callback verify-code-requested();
    callback forgot-password-requested();
    callback reset-password-requested();
    callback redeem-requested();
    callback billing-recharge-requested();
    callback billing-subscription-requested();
    callback billing-open-last-payment-requested();
    callback billing-refresh-requested();
    callback usage-refresh-requested();
    callback usage-prev-page-requested();
    callback usage-next-page-requested();
    callback usage-view-mode-changed(int);
    callback usage-export-excel-requested();
    callback session-refresh-requested();
    callback session-sync-requested();
    callback session-repair-requested();
    callback session-group-selected(int);
    callback session-entry-selected(int);
    callback session-trash-selected(int);
    callback session-move-selected-requested();
    callback session-restore-selected-requested();
    callback manual-update-check-requested();
    callback view-usage-key-requested();
    callback update-primary-requested();
    callback update-secondary-requested();

    // ═══════════════════════════════════════════
    // Layout constants from Stitch design:
    // SideNavBar: w-64 = 256px, bg: surface-container-low (#f0f4f7)
    // TopAppBar: h-16 = 64px, bg: surface-container-lowest (#ffffff) 80% + blur
    // Main content: flex-1, p-8/p-12 = 32px/48px padding
    // ═══════════════════════════════════════════

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f7f9fb;

        // ═══ SideNavBar: 256px wide, full height ═══
        Rectangle {
            x: 0px; y: 0px;
            width: 256px;
            height: parent.height;
            background: #f0f4f7; // surface-container-low

            // ── User avatar area + brand ──
            Rectangle {
                x: 24px; y: 24px;
                width: 48px; height: 48px;
                background: #eaeff2;
                border-radius: 24px;
            }

            Text {
                x: 80px; y: 28px;
                text: "一键开整";
                color: #006499;
                font-size: 20px;
                font-weight: 900;
            }

            Text {
                x: 80px; y: 52px;
                text: "Windows 客户端";
                color: #51616b;
                font-size: 12px;
            }

            // ── Nav items ──
            // Active: bg white, text primary, shadow
            // Inactive: no bg, text tertiary, hover surface-container

            // Nav 0: 总览
            Rectangle {
                x: 24px; y: 96px;
                width: 208px; height: 44px;
                nav-touch-0 := TouchArea { clicked => { root.current-section = 0; } }
                background: nav-touch-0.pressed ? #eaeff2 : (root.current-section == 0 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "总览";
                    color: root.current-section == 0 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 0 ? 700 : 400;
                }
            }

            // Nav 1: 启动 Codex
            Rectangle {
                x: 24px; y: 144px;
                width: 208px; height: 44px;
                nav-touch-1 := TouchArea { clicked => { root.current-section = 1; } }
                background: nav-touch-1.pressed ? #eaeff2 : (root.current-section == 1 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "启动 Codex";
                    color: root.current-section == 1 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 1 ? 700 : 400;
                }
            }

            // Nav 2: 计费中心
            Rectangle {
                x: 24px; y: 192px;
                width: 208px; height: 44px;
                nav-touch-2 := TouchArea { clicked => { root.current-section = 2; } }
                background: nav-touch-2.pressed ? #eaeff2 : (root.current-section == 2 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "计费中心";
                    color: root.current-section == 2 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 2 ? 700 : 400;
                }
            }

            // Nav 3: 消费明细
            Rectangle {
                x: 24px; y: 240px;
                width: 208px; height: 44px;
                nav-touch-3 := TouchArea { clicked => { root.current-section = 3; } }
                background: nav-touch-3.pressed ? #eaeff2 : (root.current-section == 3 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "消费明细";
                    color: root.current-section == 3 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 3 ? 700 : 400;
                }
            }

            // Nav 4: 设置与帮助
            Rectangle {
                x: 24px; y: 288px;
                width: 208px; height: 44px;
                nav-touch-4 := TouchArea { clicked => { root.current-section = 4; } }
                background: nav-touch-4.pressed ? #eaeff2 : (root.current-section == 4 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "设置与帮助";
                    color: root.current-section == 4 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 4 ? 700 : 400;
                }
            }

            Rectangle {
                x: 24px; y: 336px;
                width: 208px; height: 44px;
                nav-touch-5 := TouchArea { clicked => { root.current-section = 6; } }
                background: nav-touch-5.pressed ? #eaeff2 : (root.current-section == 6 ? #ffffff : transparent);
                border-radius: 8px;
                Text {
                    x: 44px; y: 12px;
                    text: "会话管理";
                    color: root.current-section == 6 ? #006499 : #51616b;
                    font-size: 14px;
                    font-weight: root.current-section == 6 ? 700 : 400;
                }
            }
        }

        // ═══ TopAppBar: h=64px, glass effect ═══
        Rectangle {
            x: 256px; y: 0px;
            width: parent.width - 256px;
            height: 64px;
            background: #ffffffcc; // 80% white, glass

            Text {
                x: 32px; y: 20px;
                text: "一键开整";
                color: #006499;
                font-size: 18px;
                font-weight: 700;
            }

            // Notification button
            Rectangle {
                x: parent.width - 56px; y: 16px;
                width: 32px; height: 32px;
                announcement-touch := TouchArea { clicked => { root.current-section = 5; } }
                background: announcement-touch.pressed ? #e2edf5 : transparent;
                border-radius: 16px;
                Text { x: 6px; y: 6px; text: "🔔"; font-size: 16px; }
            }
        }

        // ═══ Main Content Area: below TopAppBar, right of SideNav ═══
        // x: 256px, y: 64px, padded 48px

        if root.current-section == 0: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            if root.session-active: OverviewScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                welcome-text: "准备开整";
                user-label: root.dashboard-user-label;
                balance-text: root.dashboard-balance-text;
                usage-text: root.dashboard-usage-text;
                account-status-text: root.dashboard-account-status-text;
                notice-text: root.dashboard-notice-text;
                open-launch-requested => { root.current-section = 1; }
                open-billing-requested => { root.current-section = 2; }
                open-help-requested => { root.current-section = 4; }
            }
        }

        // ═══ Section 1: 启动 Codex (centered card layout) ═══
        if root.current-section == 1: Rectangle {
            x: 256px;
            y: 64px;
            width: parent.width - 256px;
            height: parent.height - 64px;
            background: #f7f9fb;

            LaunchPanel {
                x: (parent.width - 640px) / 2;
                y: 48px;
                width: 640px;
                height: parent.height - 96px;
                desktop-available: root.desktop-available;
                cli-available: root.cli-available;
                status-text: root.launch-status-text;
                group-options: root.launch-group-options;
                selected-group-index <=> root.launch-selected-group-index;
                cli-mode <=> root.launch-cli-mode;
                refresh-requested => { root.refresh-installations-requested(); }
                launch-platform-desktop-requested => { root.launch-platform-desktop-requested(); }
                launch-platform-cli-requested => { root.launch-platform-cli-requested(); }
            }
        }

        // ═══ Section 2: 计费详情 ═══
        if root.current-section == 2: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            BillingDetailScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                plan-title: root.billing-plan-title;
                balance-headline: root.billing-balance-headline;
                usage-caption: root.billing-usage-caption;
                redeem-code <=> root.redeem-code;
                redeem-status-text: root.redeem-status-text;
                subscription-summary-text: root.subscription-summary-text;
                subscription-lines: root.subscription-lines;
                subscription-detail-lines: root.subscription-detail-lines;
                order-detail-lines: root.order-detail-lines;
                history-lines: root.redeem-history-lines;
                recharge-amount <=> root.billing-recharge-amount;
                payment-method-options: root.billing-payment-method-options;
                selected-payment-method-index <=> root.billing-selected-payment-method-index;
                subscription-plan-options: root.billing-subscription-plan-options;
                selected-subscription-plan-index <=> root.billing-selected-subscription-plan-index;
                checkout-status-text: root.billing-checkout-status-text;
                redeem-requested => { root.redeem-requested(); }
                billing-recharge-requested => { root.billing-recharge-requested(); }
                billing-subscription-requested => { root.billing-subscription-requested(); }
                billing-open-last-payment-requested => { root.billing-open-last-payment-requested(); }
                billing-refresh-requested => { root.billing-refresh-requested(); }
            }
        }

        // ═══ Section 3: 消费明细 ═══
        if root.current-section == 3: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            UsageDetailScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                summary-title: root.usage-summary-title;
                total-requests-text: root.usage-total-requests-text;
                total-tokens-text: root.usage-total-tokens-text;
                total-actual-cost-text: root.usage-total-actual-cost-text;
                model-lines: root.usage-model-lines;
                time-lines: root.usage-time-lines;
                input-lines: root.usage-input-lines;
                output-lines: root.usage-output-lines;
                page-meta-text: root.usage-page-meta-text;
                view-mode-options: root.usage-view-mode-options;
                selected-view-mode-index <=> root.usage-selected-view-mode-index;
                status-text: root.usage-status-text;
                refresh-requested => { root.usage-refresh-requested(); }
                prev-page-requested => { root.usage-prev-page-requested(); }
                next-page-requested => { root.usage-next-page-requested(); }
                view-mode-changed(index) => { root.usage-view-mode-changed(index); }
                export-excel-requested => { root.usage-export-excel-requested(); }
            }
        }

        // ═══ Section 4: 设置与帮助 ═══
        if root.current-section == 4: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            HelpDetailScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                desktop-available: root.desktop-available;
                cli-available: root.cli-available;
                launch-status-text: root.launch-status-text;
                view-key-password <=> root.view-key-password;
                view-key-status-text: root.view-key-status-text;
                manual-update-check-requested => { root.manual-update-check-requested(); }
                refresh-installations-requested => { root.refresh-installations-requested(); }
                launch-official-desktop-requested => { root.launch-desktop-requested(); }
                launch-official-cli-requested => { root.launch-cli-requested(); }
                view-usage-key-requested => { root.view-usage-key-requested(); }
            }
        }

        // ═══ Section 5: 公告中心 ═══
        if root.current-section == 5: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            AnnouncementCenterScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                hero-version: root.announcement-hero-version;
                hero-title: root.announcement-hero-title;
                hero-summary: root.announcement-hero-summary;
                version-lines: root.announcement-version-lines;
                announcement-feed-lines: root.announcement-feed-lines;
            }
        }

        if root.current-section == 6: Rectangle {
            x: 256px + 48px;
            y: 64px + 48px;
            width: parent.width - 256px - 96px;
            height: parent.height - 64px - 96px;
            background: transparent;

            SessionManagerScreen {
                x: 0px; y: 0px;
                width: parent.width;
                height: parent.height;
                home-count-text: root.session-home-count-text;
                session-count-text: root.session-count-text;
                trash-count-text: root.session-trash-count-text;
                status-text: root.session-status-text;
                group-lines: root.session-group-lines;
                selected-group-index <=> root.session-selected-group-index;
                session-lines: root.session-entry-lines;
                selected-session-index <=> root.session-selected-entry-index;
                trash-lines: root.session-trash-lines;
                selected-trash-index <=> root.session-selected-trash-index;
                refresh-requested => { root.session-refresh-requested(); }
                sync-requested => { root.session-sync-requested(); }
                repair-requested => { root.session-repair-requested(); }
                group-selected(index) => { root.session-group-selected(index); }
                session-selected(index) => { root.session-entry-selected(index); }
                trash-selected(index) => { root.session-trash-selected(index); }
                move-selected-requested => { root.session-move-selected-requested(); }
                restore-selected-requested => { root.session-restore-selected-requested(); }
            }
        }

        // ═══ Login Scene overlay (when !session-active, covers everything) ═══
        if !root.session-active && root.current-section != 6: LoginScene {
            x: 0px; y: 0px;
            width: parent.width;
            height: parent.height;
            email <=> root.email;
            password <=> root.password;
            verification-code <=> root.verification-code;
            reset-token <=> root.reset-token;
            new-password <=> root.new-password;
            remember-password <=> root.remember-password;
            auto-login <=> root.auto-login;
            auth-busy <=> root.auth-busy;
            show-totp-field <=> root.show-login-totp;
            auth-subview <=> root.auth-subview;
            showing-announcements: root.current-section == 5;
            auth-status-text: root.auth-status-text;
            reset-status-text: root.reset-status-text;
            brand-status-copy: root.brand-status-copy;
            announcement-hero-version: root.announcement-hero-version;
            announcement-hero-title: root.announcement-hero-title;
            announcement-hero-summary: root.announcement-hero-summary;
            announcement-version-lines: root.announcement-version-lines;
            announcement-feed-lines: root.announcement-feed-lines;
            login-requested => { root.login-requested(); }
            register-requested => { root.register-requested(); }
            verify-code-requested => { root.verify-code-requested(); }
            forgot-password-requested => { root.forgot-password-requested(); }
            reset-password-requested => { root.reset-password-requested(); }
        }

        UpdateDialog {
            width: parent.width;
            height: parent.height;
            dialog-visible: root.update-dialog-visible;
            force-update: root.update-force;
            current-version: root.update-current-version;
            latest-version: root.update-latest-version;
            summary: root.update-summary;
            primary-requested => { root.update-primary-requested(); }
            secondary-requested => { root.update-secondary-requested(); }
        }
    }
}
