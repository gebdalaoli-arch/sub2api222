import { Button } from "std-widgets.slint";

export component UpdateDialog inherits Rectangle {
    in property <bool> dialog-visible: false;
    in property <bool> force-update: false;
    in property <string> latest-version: "v0.0.0";
    in property <string> current-version: "v0.0.0";
    in property <string> summary: "当前版本已是最新。";

    callback primary-requested();
    callback secondary-requested();

    background: transparent;

    if root.dialog-visible: Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        background: #6d7685cc;
        border-radius: 30px;

        Rectangle {
            x: 36px;
            y: 36px;
            width: parent.width - 72px;
            height: parent.height - 72px;
            background: #ffffff;
            border-radius: 30px;
            border-color: #d7e4f0;
            border-width: 1px;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 104px;
                background: #ffffff;
                border-radius: 30px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 28px;
                    y: 30px;
                    text: "发现新版本";
                    color: #17324a;
                    font-size: 30px;
                    font-weight: 800;
                }
            }

            Text {
                x: 28px;
                y: 138px;
                text: root.latest-version;
                color: #2b59d0;
                font-size: 22px;
                font-weight: 700;
            }

            Text {
                x: 28px;
                y: 178px;
                width: parent.width - 56px;
                text: "当前版本 " + root.current-version + "，新版本已可用。";
                color: #5f7892;
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle {
                x: 28px;
                y: 230px;
                width: parent.width - 56px;
                height: 12px;
                background: #eef3f9;
                border-radius: 6px;
            }

            Text {
                x: 28px;
                y: 264px;
                width: parent.width - 56px;
                text: root.summary;
                color: #17324a;
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle {
                x: 28px;
                y: 360px;
                width: parent.width - 56px;
                height: parent.height - 452px;
                background: #fbfcfe;
                border-radius: 18px;
                border-color: #d7e4f0;
                border-width: 1px;
                Text {
                    x: 16px;
                    y: 16px;
                    text: "更新内容与公告";
                    color: #21435f;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    x: 16px;
                    y: 48px;
                    width: parent.width - 32px;
                    text: "1. 新版将带来更稳定的一键开整体验。  2. 更新中心会支持下载进度、校验和安装接力。";
                    color: #688097;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            if !root.force-update: Button {
                x: parent.width - 244px;
                y: parent.height - 70px;
                width: 92px;
                height: 42px;
                text: "稍后";
                clicked => { root.secondary-requested(); }
            }

            Button {
                x: parent.width - 140px;
                y: parent.height - 70px;
                width: 112px;
                height: 42px;
                text: "立即更新";
                clicked => { root.primary-requested(); }
            }
        }
    }
}
