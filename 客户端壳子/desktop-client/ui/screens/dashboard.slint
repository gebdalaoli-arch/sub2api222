import { Button } from "std-widgets.slint";

export component DashboardScreen inherits Rectangle {
    in property <string> balance-text: "剩余 Token：--";
    in property <string> usage-text: "累计消费：--";
    in property <string> recharge-notice: "兑换 Token CDK 后，可在计费中心查看剩余、充值与消费明细。";
    in property <string> user-label: "未登录";
    in property <string> account-status-text: "账户状态：待登录";

    callback redeem-requested();
    callback launch-requested();

    background: #eaeff2;
    border-radius: 12px;
    border-color: #d7e4f0;
    border-width: 0px;

    Text {
        x: 24px;
        y: 20px;
        text: "账户总览";
        color: #2c3437;
        font-size: 24px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: root.user-label;
        color: #596064;
        font-size: 13px;
    }

    Rectangle {
        x: 24px;
        y: 92px;
        width: (parent.width - 64px) / 3;
        height: 84px;
        background: #ffffff;
        border-radius: 12px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text { x: 16px; y: 14px; text: "剩余"; color: #596064; font-size: 12px; font-weight: 700; }
        Text { x: 16px; y: 38px; text: root.balance-text; color: #2c3437; font-size: 18px; font-weight: 800; }
    }

    Rectangle {
        x: 32px + (parent.width - 64px) / 3;
        y: 92px;
        width: (parent.width - 64px) / 3;
        height: 84px;
        background: #ffffff;
        border-radius: 12px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text { x: 16px; y: 14px; text: "消费"; color: #596064; font-size: 12px; font-weight: 700; }
        Text { x: 16px; y: 38px; text: root.usage-text; color: #2c3437; font-size: 18px; font-weight: 800; }
    }

    Rectangle {
        x: 40px + ((parent.width - 64px) / 3) * 2;
        y: 92px;
        width: (parent.width - 64px) / 3;
        height: 84px;
        background: #ffffff;
        border-radius: 12px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text { x: 16px; y: 14px; text: "状态"; color: #596064; font-size: 12px; font-weight: 700; }
        Text { x: 16px; y: 38px; width: parent.width - 32px; text: root.account-status-text; color: #2c3437; font-size: 14px; font-weight: 700; wrap: word-wrap; }
    }

    Rectangle {
        x: 24px;
        y: 196px;
        width: parent.width - 48px;
        height: max(74px, parent.height - 284px);
        background: #ffffff;
        border-radius: 12px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text {
            x: 16px;
            y: 16px;
            text: "公告与交付说明";
            color: #2c3437;
            font-size: 14px;
            font-weight: 700;
        }

        Text {
            x: 16px;
            y: 42px;
            width: parent.width - 32px;
            text: root.recharge-notice;
            color: #596064;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    Button {
        x: 24px;
        y: parent.height - 56px;
        width: 126px;
        height: 40px;
        text: "兑换 CDK";
        clicked => { root.redeem-requested(); }
    }

    Button {
        x: 164px;
        y: parent.height - 56px;
        width: 148px;
        height: 40px;
        text: "前往启动中心";
        clicked => { root.launch-requested(); }
    }
}
