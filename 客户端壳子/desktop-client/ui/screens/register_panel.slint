import { Button, LineEdit } from "std-widgets.slint";

export component RegisterPanel inherits Rectangle {
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in property <string> status-text: "先发送验证码，再创建账户。";

    callback register-submit-requested();
    callback verify-code-requested();
    callback back-requested();

    background: #ffffff;
    border-radius: 12px;
    border-color: #d7e4f0;
    border-width: 0px;

    Text {
        x: 24px;
        y: 20px;
        text: "创建账户";
        color: #2c3437;
        font-size: 24px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: "注册是次路径。先拿邮箱验证码，再把账户创建完整。";
        color: #596064;
        font-size: 13px;
        wrap: word-wrap;
    }

    Text { x: 24px; y: 108px; text: "邮箱"; color: #596064; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 128px;
        width: parent.width - 48px;
        height: 40px;
        text <=> root.email;
        placeholder-text: "name@example.com";
    }

    Text { x: 24px; y: 188px; text: "密码"; color: #596064; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 208px;
        width: parent.width - 48px;
        height: 40px;
        text <=> root.password;
        placeholder-text: "创建一个安全密码";
        input-type: InputType.password;
    }

    Text { x: 24px; y: 268px; text: "验证码"; color: #596064; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 288px;
        width: parent.width - 148px;
        height: 40px;
        text <=> root.verification-code;
        placeholder-text: "输入邮箱验证码";
    }

    Button {
        x: parent.width - 108px;
        y: 288px;
        width: 84px;
        height: 40px;
        text: "发验证码";
        clicked => { root.verify-code-requested(); }
    }

    Button {
        x: 24px;
        y: 352px;
        width: 112px;
        height: 42px;
        text: "返回";
        clicked => { root.back-requested(); }
    }

    Button {
        x: parent.width - 136px;
        y: 352px;
        width: 112px;
        height: 42px;
        text: "创建账户";
        clicked => { root.register-submit-requested(); }
    }

    Rectangle {
        x: 24px;
        y: 418px;
        width: parent.width - 48px;
        height: 70px;
        background: #eaeff2;
        border-radius: 12px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text {
            x: 16px;
            y: 14px;
            width: parent.width - 32px;
            text: root.status-text;
            color: #596064;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
