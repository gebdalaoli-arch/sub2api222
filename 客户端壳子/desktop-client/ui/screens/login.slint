import { Button, LineEdit } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <bool> remember-password: true;
    in-out property <bool> auto-login: false;
    in property <bool> show-totp-field: false;
    in property <string> status-text: "请输入邮箱和密码。";
    in property <bool> busy: false;

    callback login-requested();
    callback open-register-requested();
    callback open-forgot-password-requested();

    // Card: surface-container-lowest (#ffffff), rounded-xl (12px), ambient shadow
    background: #ffffff;
    border-radius: 12px;

    // ─── Title: 账户登录 ───
    Text {
        x: 40px; y: 40px;
        text: "账户登录";
        color: #2c3437;
        font-size: 28px;
        font-weight: 700;
    }

    // ─── Email Label (label-sm uppercase) ───
    Text {
        x: 40px; y: 104px;
        text: "电子邮箱 / 账号";
        color: #596064;
        font-size: 11px;
        font-weight: 600;
    }

    // ─── Email Input (bottom-border-only style) ───
    LineEdit {
        x: 40px; y: 124px;
        width: parent.width - 80px;
        height: 42px;
        text <=> root.email;
        placeholder-text: "请输入您的账号";
    }

    // ─── Password Label ───
    Text {
        x: 40px; y: 190px;
        text: "密码";
        color: #596064;
        font-size: 11px;
        font-weight: 600;
    }

    // ─── Password Input ───
    LineEdit {
        x: 40px; y: 210px;
        width: parent.width - 80px;
        height: 42px;
        text <=> root.password;
        placeholder-text: "请输入密码";
        input-type: InputType.password;
    }

    // ─── 2FA field (conditional) ───
    if root.show-totp-field: Text {
        x: 40px; y: 276px;
        text: "验证码 / 2FA";
        color: #596064;
        font-size: 11px;
        font-weight: 600;
    }

    if root.show-totp-field: LineEdit {
        x: 40px; y: 296px;
        width: parent.width - 80px;
        height: 42px;
        text <=> root.verification-code;
        placeholder-text: "输入 2FA 验证码";
    }

    // ─── Options: checkboxes simulated as toggle pills ───
    property <length> opts-y: root.show-totp-field ? 358px : 276px;

    Rectangle {
        x: 40px;
        y: root.opts-y;
        width: 92px;
        height: 32px;
        remember-touch := TouchArea {
            enabled: !root.busy;
            clicked => {
                root.remember-password = !root.remember-password;
                if (!root.remember-password) { root.auto-login = false; }
            }
        }
        background: remember-touch.pressed ? #d7e4f0 : (root.remember-password ? #eaeff2 : #f7f9fb);
        border-radius: 4px;
        Text {
            x: 12px; y: 8px;
            text: "记住密码";
            color: root.remember-password ? #2c3437 : #596064;
            font-size: 14px;
            font-weight: 500;
        }
    }

    Rectangle {
        x: 148px;
        y: root.opts-y;
        width: 108px;
        height: 32px;
        auto-touch := TouchArea {
            enabled: root.remember-password && !root.busy;
            clicked => { if (root.remember-password) { root.auto-login = !root.auto-login; } }
        }
        background: auto-touch.pressed ? #d7e4f0 : (root.remember-password && root.auto-login ? #eaeff2 : #f7f9fb);
        border-radius: 4px;
        Text {
            x: 12px; y: 8px;
            text: "自动登录";
            color: root.remember-password ? (root.auto-login ? #2c3437 : #596064) : #596064;
            font-size: 14px;
            font-weight: 500;
        }
    }

    // ─── Primary Login Button ───
    property <length> btn-y: root.show-totp-field ? 414px : 332px;

    Rectangle {
        x: 40px;
        y: root.btn-y;
        width: parent.width - 80px;
        height: 48px;
        login-touch := TouchArea {
            enabled: !root.busy;
            clicked => { root.login-requested(); }
        }
        background: login-touch.pressed ? #00527d : #006499;
        border-radius: 4px;
        Text {
            width: parent.width; height: parent.height;
            text: root.busy ? "登录中..." : "登录";
            color: #f6f9ff;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 40px;
        y: root.btn-y + 60px;
        width: parent.width - 80px;
        text: root.status-text;
        color: root.busy ? #006499 : #596064;
        font-size: 12px;
        wrap: word-wrap;
    }

    // ─── Secondary links ───
    property <length> links-y: root.show-totp-field ? 500px : 418px;

    Rectangle {
        x: 40px;
        y: root.links-y;
        width: 64px; height: 20px;
        background: transparent;
        register-touch := TouchArea { enabled: !root.busy; clicked => { root.open-register-requested(); } }
        Text {
            text: "立即注册";
            color: register-touch.pressed ? #00527d : #006499;
            font-size: 11px;
            font-weight: 500;
        }
    }

    Rectangle {
        x: parent.width - 112px;
        y: root.links-y;
        width: 72px; height: 20px;
        background: transparent;
        forgot-touch := TouchArea { enabled: !root.busy; clicked => { root.open-forgot-password-requested(); } }
        Text {
            text: "忘记密码？";
            color: forgot-touch.pressed ? #2c3437 : #596064;
            font-size: 11px;
            font-weight: 500;
        }
    }
}
