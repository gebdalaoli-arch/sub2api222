import { Button, LineEdit } from "std-widgets.slint";

export component ForgotPasswordScreen inherits Rectangle {
    in-out property <string> email;
    in-out property <string> reset-token;
    in-out property <string> new-password;
    in property <string> status-text: "输入邮箱后发送重置邮件";

    callback forgot-password-requested();
    callback reset-password-requested();
    callback back-requested();

    height: 512px;
    background: #ffffff;
    border-radius: 24px;
    border-color: #d7e4f0;
    border-width: 1px;

    Text {
        x: 24px;
        y: 20px;
        text: "密码恢复";
        color: #18324a;
        font-size: 22px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 52px;
        width: parent.width - 48px;
        text: "找回密码也是次路径。先发重置邮件，再把邮件里的重置码和新密码填进来。";
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }

    LineEdit {
        x: 24px;
        y: 112px;
        width: parent.width - 150px;
        height: 40px;
        text <=> root.email;
        placeholder-text: "重置邮箱";
    }

    Button {
        x: parent.width - 114px;
        y: 112px;
        width: 90px;
        height: 40px;
        text: "发送";
        clicked => { root.forgot-password-requested(); }
    }

    LineEdit {
        x: 24px;
        y: 178px;
        width: 200px;
        height: 40px;
        text <=> root.reset-token;
        placeholder-text: "邮件重置码";
    }

    LineEdit {
        x: 240px;
        y: 178px;
        width: parent.width - 364px;
        height: 40px;
        text <=> root.new-password;
        placeholder-text: "新密码";
        input-type: InputType.password;
    }

    Button {
        x: parent.width - 108px;
        y: 178px;
        width: 84px;
        height: 40px;
        text: "重设";
        clicked => { root.reset-password-requested(); }
    }

    Rectangle {
        x: 24px;
        y: 244px;
        width: parent.width - 48px;
        height: 78px;
        background: #f6f9fd;
        border-radius: 18px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            text: root.status-text;
            color: #5b7490;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    Button {
        x: 24px;
        y: parent.height - 66px;
        width: 104px;
        height: 42px;
        text: "返回";
        clicked => { root.back-requested(); }
    }
}
