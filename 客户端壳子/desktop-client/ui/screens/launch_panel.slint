import { Button, ComboBox } from "std-widgets.slint";

export component LaunchPanel inherits Rectangle {
    in property <bool> desktop-available: false;
    in property <bool> cli-available: false;
    in property <string> status-text: "尚未检测 Codex 安装";
    in property <[string]> group-options: ["登录后加载可用分组"];
    in-out property <int> selected-group-index: 0;
    in-out property <bool> cli-mode: false;

    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback refresh-requested();

    background: #ffffff;
    border-radius: 28px;
    border-color: #dce6ef;
    border-width: 1px;

    property <length> panel-width: self.width - 48px;

    Text {
        x: 24px;
        y: 20px;
        text: "启动 Codex";
        color: #18324a;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: root.status-text;
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: parent.width - 152px;
        y: 18px;
        width: 128px;
        height: 30px;
        background: #edf8ff;
        border-radius: 14px;
        border-color: #d5e4f7;
        border-width: 1px;
        Text { x: 16px; y: 8px; text: "环境已就绪"; color: #315577; font-size: 11px; font-weight: 700; }
    }

    Rectangle {
        x: 24px;
        y: 96px;
        width: root.panel-width;
        height: 88px;
        background: #f8fbff;
        border-radius: 20px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text { x: 16px; y: 14px; text: "环境状态"; color: #24415c; font-size: 15px; font-weight: 700; }
        Text { x: 16px; y: 38px; text: root.desktop-available || root.cli-available ? "Codex 环境已经可用，可以直接进入启动流程。" : "当前未检测到可用的 Codex 环境。"; color: #688097; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            x: parent.width - 86px;
            y: 28px;
            width: 62px;
            height: 24px;
            background: root.desktop-available || root.cli-available ? #eaf8ef : #f2f5f8;
            border-radius: 12px;
            border-color: root.desktop-available || root.cli-available ? #cce6d4 : #d7e4f0;
            border-width: 1px;
            Text { x: 14px; y: 6px; text: root.desktop-available || root.cli-available ? "就绪" : "缺失"; color: root.desktop-available || root.cli-available ? #2d6a42 : #6d8398; font-size: 10px; font-weight: 700; }
        }
    }

    Rectangle {
        x: 24px;
        y: 202px;
        width: root.panel-width;
        height: 74px;
        background: #f8fbff;
        border-radius: 20px;
        border-color: #d7e4f0;
        border-width: 1px;

        Rectangle {
            x: 16px;
            y: 16px;
            width: 112px;
            height: 42px;
            background: !root.cli-mode ? #dff3ff : #ffffff;
            border-radius: 16px;
            border-color: !root.cli-mode ? #b6ddf7 : #d7e4f0;
            border-width: 1px;
            TouchArea { clicked => { root.cli-mode = false; } }
            Text { x: 24px; y: 12px; text: "桌面版"; color: !root.cli-mode ? #1f5f8f : #6d8398; font-size: 13px; font-weight: 700; }
        }
        Rectangle {
            x: 136px;
            y: 16px;
            width: 112px;
            height: 42px;
            background: root.cli-mode ? #dff3ff : #ffffff;
            border-radius: 16px;
            border-color: root.cli-mode ? #b6ddf7 : #d7e4f0;
            border-width: 1px;
            TouchArea { clicked => { root.cli-mode = true; } }
            Text { x: 42px; y: 12px; text: "CLI"; color: root.cli-mode ? #1f5f8f : #6d8398; font-size: 13px; font-weight: 700; }
        }
        Text { x: 270px; y: 28px; text: root.cli-mode ? "已切换到 CLI 模式" : "默认使用桌面版启动"; color: #688097; font-size: 12px; }
    }

    Text {
        x: 24px;
        y: 300px;
        text: "启动分组";
        color: #18324a;
        font-size: 17px;
        font-weight: 700;
    }

    Text {
        x: 24px;
        y: 324px;
        width: root.panel-width;
        text: "选择这次启动要使用的分组，客户端会按当前分组准备受管环境。";
        color: #688097;
        font-size: 12px;
        wrap: word-wrap;
    }

    ComboBox {
        x: 24px;
        y: 356px;
        width: root.panel-width;
        height: 40px;
        model: root.group-options;
        current-index <=> root.selected-group-index;
    }

    Button {
        x: 24px;
        y: parent.height - 116px;
        width: 120px;
        height: 40px;
        text: "检测安装";
        clicked => { root.refresh-requested(); }
    }

    Button {
        x: 158px;
        y: parent.height - 116px;
        width: root.panel-width - 134px;
        height: 40px;
        text: root.cli-mode ? "立即启动 CLI" : "立即启动桌面版";
        enabled: root.cli-mode ? root.cli-available : root.desktop-available;
        clicked => { if (root.cli-mode) { root.launch-platform-cli-requested(); } else { root.launch-platform-desktop-requested(); } }
    }

    Text {
        x: 24px;
        y: parent.height - 62px;
        width: parent.width - 48px;
        text: "高级设置中可启用官方模式";
        color: #8aa0b3;
        font-size: 12px;
        horizontal-alignment: right;
    }
}
