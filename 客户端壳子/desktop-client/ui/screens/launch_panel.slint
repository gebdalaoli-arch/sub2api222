import { Button, ComboBox } from "std-widgets.slint";

export component LaunchPanel inherits Rectangle {
    in property <bool> desktop-available: false;
    in property <bool> cli-available: false;
    in property <string> status-text: "尚未检测 Codex 安装";
    in property <[string]> group-options: ["登录后加载可用分组"];
    in-out property <int> selected-group-index: 0;
    in-out property <bool> cli-mode: false;

    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback refresh-requested();

    background: #ffffff;
    border-radius: 12px;

    // ─── 环境状态 ───
    Rectangle {
        x: 40px; y: 40px;
        width: parent.width - 80px;
        height: 52px;
        background: #f0f4f7; // surface-container-low
        border-radius: 8px;

        // Status dot
        Rectangle {
            x: 16px; y: 20px;
            width: 10px; height: 10px;
            background: root.desktop-available || root.cli-available ? #10b981 : #d4dbdf;
            border-radius: 5px;
        }

        Text {
            x: 34px; y: 16px;
            text: "环境状态";
            color: #2c3437;
            font-size: 14px;
            font-weight: 600;
        }

        Rectangle {
            x: parent.width - 80px; y: 12px;
            width: 64px; height: 28px;
            background: #f7f9fb;
            border-radius: 4px;
            Text {
                width: parent.width; height: parent.height;
                text: root.desktop-available || root.cli-available ? "已就绪" : "未就绪";
                color: #51616b;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ─── 启动方式 ───
    Text {
        x: 40px; y: 116px;
        text: "启动方式";
        color: #596064;
        font-size: 11px;
        font-weight: 600;
    }

    Rectangle {
        x: 40px; y: 140px;
        width: 300px; height: 44px;
        background: #f0f4f7;
        border-radius: 8px;

        Rectangle {
            x: 4px; y: 4px;
            width: 168px; height: 36px;
            background: !root.cli-mode ? #ffffff : transparent;
            border-radius: 4px;
            TouchArea { clicked => { root.cli-mode = false; } }
            Text {
                width: parent.width; height: parent.height;
                text: "桌面版";
                color: !root.cli-mode ? #006499 : #596064;
                font-size: 14px;
                font-weight: !root.cli-mode ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: 176px; y: 4px;
            width: 120px; height: 36px;
            background: root.cli-mode ? #ffffff : transparent;
            border-radius: 4px;
            TouchArea { clicked => { root.cli-mode = true; } }
            Text {
                width: parent.width; height: parent.height;
                text: "CLI";
                color: root.cli-mode ? #006499 : #596064;
                font-size: 14px;
                font-weight: root.cli-mode ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ─── 启动分组 ───
    Text {
        x: 40px; y: 208px;
        text: "启动分组";
        color: #596064;
        font-size: 11px;
        font-weight: 600;
    }

    ComboBox {
        x: 40px; y: 232px;
        width: parent.width - 80px;
        height: 48px;
        model: root.group-options;
        current-index <=> root.selected-group-index;
    }

    // ─── Primary Action Button ───
    Rectangle {
        x: 40px;
        y: parent.height - 120px;
        width: parent.width - 80px;
        height: 52px;
        background: #006499;
        border-radius: 8px;
        TouchArea {
            clicked => {
                if (root.cli-mode) { root.launch-platform-cli-requested(); }
                else { root.launch-platform-desktop-requested(); }
            }
        }
        Text {
            width: parent.width; height: parent.height;
            text: root.cli-mode ? "立即启动 CLI" : "立即启动桌面版";
            color: #f6f9ff;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 40px;
        y: parent.height - 52px;
        width: parent.width - 80px;
        text: "官方模式已收纳到高级设置";
        color: #596064;
        font-size: 11px;
        horizontal-alignment: center;
    }
}
