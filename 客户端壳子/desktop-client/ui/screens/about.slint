export component AboutScreen inherits Rectangle {
    background: #eaeff2;
    border-radius: 12px;
    border-color: #d7e4f0;
    border-width: 0px;

    Text {
        x: 24px;
        y: 18px;
        text: "隐私与连接原则";
        color: #2c3437;
        font-size: 20px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 52px;
        width: parent.width - 48px;
        text: "客户端不展示普通连接密钥，不要求你复制服务地址。官方模式保持原样，平台代理模式使用独立受管运行目录。";
        color: #596064;
        font-size: 13px;
        wrap: word-wrap;
    }
}
