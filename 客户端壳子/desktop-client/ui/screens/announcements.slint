import { Button } from "std-widgets.slint";

export component AnnouncementCenterScreen inherits Rectangle {
    in property <string> hero-version: "最新动态";
    in property <string> hero-title: "公告中心已准备就绪";
    in property <string> hero-summary: "这里会展示系统更新、维护通知和使用提醒。";
    in property <[string]> version-lines: ["暂无版本动态"];
    in property <[string]> announcement-feed-lines: ["暂无系统公告"];

    background: #ffffff;
    border-radius: 12px;
    border-color: #d7e4f0;
    border-width: 0px;

    Text {
        x: 24px;
        y: 20px;
        text: "公告中心";
        color: #2c3437;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 58px;
        width: parent.width - 48px;
        text: "系统更新、维护通知和使用提醒都收在这里。";
        color: #596064;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: 24px;
        y: 102px;
        width: 92px;
        height: 34px;
        background: #e7f5ff;
        border-radius: 8px;
        Text { x: 18px; y: 9px; text: "系统更新"; color: #2c3437; font-size: 12px; font-weight: 700; }
    }

    Rectangle {
        x: 126px;
        y: 102px;
        width: 92px;
        height: 34px;
        background: #f5f7fa;
        border-radius: 8px;
        Text { x: 18px; y: 9px; text: "维护通知"; color: #596064; font-size: 12px; font-weight: 700; }
    }

    Rectangle {
        x: 228px;
        y: 102px;
        width: 92px;
        height: 34px;
        background: #f5f7fa;
        border-radius: 8px;
        Text { x: 18px; y: 9px; text: "使用提醒"; color: #596064; font-size: 12px; font-weight: 700; }
    }

    Rectangle {
        x: 24px;
        y: 158px;
        width: parent.width - 336px;
        height: 126px;
        background: @linear-gradient(90deg, #eef8ff 0%, #f8fcff 100%);
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 0px;
        Text { x: 20px; y: 18px; text: "置顶公告"; color: #006499; font-size: 12px; font-weight: 700; }
        Text { x: 20px; y: 42px; text: root.hero-title; color: #2c3437; font-size: 22px; font-weight: 800; }
        Text { x: 20px; y: 74px; width: parent.width - 160px; text: root.hero-summary; color: #596064; font-size: 12px; wrap: word-wrap; }
        Button {
            x: parent.width - 118px;
            y: 42px;
            width: 94px;
            height: 40px;
            text: root.hero-version;
        }
    }

    Rectangle {
        x: parent.width - 288px;
        y: 158px;
        width: 264px;
        height: parent.height - 182px;
        background: #eaeff2;
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 0px;
        Text { x: 18px; y: 18px; text: "版本动态"; color: #2c3437; font-size: 18px; font-weight: 800; }
        for line[index] in root.version-lines : Rectangle {
            x: 18px;
            y: 52px + index * 56px;
            width: parent.width - 36px;
            height: 44px;
            background: #ffffff;
            border-radius: 10px;
            Text {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                text: line;
                color: #596064;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    Rectangle {
        x: 24px;
        y: 302px;
        width: parent.width - 336px;
        height: parent.height - 326px;
        background: #eaeff2;
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 0px;

        for line[index] in root.announcement-feed-lines : Rectangle {
            x: 16px;
            y: 16px + index * 96px;
            width: parent.width - 32px;
            height: 84px;
            background: #ffffff;
            border-radius: 12px;
            border-color: #d7e4f0;
            border-width: 0px;
            Text {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                text: line;
                color: #596064;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
