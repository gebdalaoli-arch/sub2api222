import { Button, LineEdit } from "std-widgets.slint";

export component BillingDetailScreen inherits Rectangle {
    in property <string> plan-title: "暂未开通订阅";
    in property <string> balance-headline: "¥--";
    in property <string> usage-caption: "登录后可查看余额与订单明细。";
    in property <string> subscription-summary-text: "暂无订阅摘要";
    in property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in property <[string]> subscription-detail-lines: ["暂无订阅明细。"];
    in property <[string]> order-detail-lines: ["暂无订单明细。"];
    in property <[string]> history-lines: ["最近兑换记录会显示在这里。"];
    in-out property <string> redeem-code;
    in property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in-out property <string> recharge-amount: "";
    in property <[string]> payment-method-options: ["暂无可用支付方式"];
    in-out property <int> selected-payment-method-index: 0;
    in property <[string]> subscription-plan-options: ["暂无可用套餐"];
    in-out property <int> selected-subscription-plan-index: 0;
    in property <string> checkout-status-text: "支付创建后会在这里显示状态。";

    callback redeem-requested();
    callback billing-recharge-requested();
    callback billing-subscription-requested();
    callback billing-open-last-payment-requested();
    callback billing-refresh-requested();

    background: #ffffff;
    border-radius: 12px;
    border-color: #dce6ef;
    border-width: 0px;

    property <length> content-width: self.width - 48px;
    property <length> left-width: (root.content-width - 20px) * 0.58;
    property <length> right-width: root.content-width - root.left-width - 20px;

    Text {
        x: 24px;
        y: 20px;
        text: "计费中心";
        color: #2c3437;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 56px;
        width: parent.width - 48px;
        text: "当前以兑换 CDK 为主入口；充值、套餐与明细能力统一收纳在暂未开放区。";
        color: #596064;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: 24px;
        y: 102px;
        width: root.left-width;
        height: parent.height - 126px;
        background: @linear-gradient(135deg, #fafdff 0%, #eef7fc 100%);
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text {
            x: 24px;
            y: 22px;
            text: "兑换 CDK";
            color: #2c3437;
            font-size: 26px;
            font-weight: 800;
        }

        Text {
            x: 24px;
            y: 58px;
            width: parent.width - 48px;
            text: "输入兑换码后立即入账，是当前商业版默认开放的主要计费入口。";
            color: #596064;
            font-size: 13px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 24px;
            y: 104px;
            width: (parent.width - 60px) / 2;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;

            Text { x: 14px; y: 14px; text: "钱包余额"; color: #596064; font-size: 11px; font-weight: 700; }
            Text { x: 14px; y: 38px; text: root.balance-headline; color: #2c3437; font-size: 22px; font-weight: 800; }
        }

        Rectangle {
            x: 36px + (parent.width - 60px) / 2;
            y: 104px;
            width: (parent.width - 60px) / 2;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;

            Text { x: 14px; y: 14px; text: "当前套餐"; color: #596064; font-size: 11px; font-weight: 700; }
            Text {
                x: 14px;
                y: 34px;
                width: parent.width - 28px;
                text: root.plan-title;
                color: #2c3437;
                font-size: 16px;
                font-weight: 800;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 24px;
            y: 206px;
            width: parent.width - 48px;
            height: 94px;
            background: #ffffff;
            border-radius: 18px;

            LineEdit {
                x: 16px;
                y: 18px;
                width: parent.width - 148px;
                height: 36px;
                text <=> root.redeem-code;
                placeholder-text: "输入 CDK";
            }

            Button {
                x: parent.width - 112px;
                y: 18px;
                width: 96px;
                height: 36px;
                text: "兑换 CDK";
                clicked => { root.redeem-requested(); }
            }

            Text {
                x: 16px;
                y: 64px;
                width: parent.width - 32px;
                text: root.redeem-status-text;
                color: #596064;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 24px;
            y: 316px;
            width: parent.width - 48px;
            height: 64px;
            background: #ffffff;
            border-radius: 14px;

            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                text: root.subscription-summary-text;
                color: #2c3437;
                font-size: 13px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                x: 16px;
                y: 34px;
                width: parent.width - 32px;
                text: root.usage-caption;
                color: #596064;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Text {
            x: 24px;
            y: 398px;
            text: "最近兑换记录";
            color: #2c3437;
            font-size: 18px;
            font-weight: 800;
        }

        for line[index] in root.history-lines : Rectangle {
            x: 24px;
            y: 432px + index * 60px;
            width: parent.width - 48px;
            height: 48px;
            background: #ffffff;
            border-radius: 12px;

            Text {
                x: 14px;
                y: 8px;
                width: parent.width - 28px;
                text: line;
                color: #596064;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    Rectangle {
        x: 24px + root.left-width + 20px;
        y: 102px;
        width: root.right-width;
        height: parent.height - 126px;
        background: #f7f9fb;
        border-radius: 22px;
        border-color: #dce6ef;
        border-width: 1px;

        Rectangle {
            x: 20px;
            y: 20px;
            width: 96px;
            height: 28px;
            background: #fff2e8;
            border-radius: 14px;

            Text {
                width: parent.width;
                height: parent.height;
                text: "暂未开放";
                color: #c6692a;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 20px;
            y: 60px;
            text: "预留能力";
            color: #2c3437;
            font-size: 22px;
            font-weight: 800;
        }

        Text {
            x: 20px;
            y: 96px;
            width: parent.width - 40px;
            text: "余额充值、套餐购买、订阅明细和订单明细已接好桌面端数据与回调，但在当前版本统一收纳，不作为主入口展示。";
            color: #596064;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 20px;
            y: 160px;
            width: parent.width - 40px;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 16px; text: "余额充值"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 42px; width: parent.width - 32px; text: "后续将恢复创建充值订单与支付方式选择。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 256px;
            width: parent.width - 40px;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 16px; text: "套餐购买"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 42px; width: parent.width - 32px; text: "后续将恢复套餐选择、续费和付款页联动。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 352px;
            width: parent.width - 40px;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 16px; text: "订阅明细"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 42px; width: parent.width - 32px; text: "后续将展示分组额度、到期时间和订阅消耗。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 448px;
            width: parent.width - 40px;
            height: 84px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 16px; text: "订单明细"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 42px; width: parent.width - 32px; text: "后续将恢复订单列表、状态追踪和付款入口。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: parent.height - 92px;
            width: parent.width - 40px;
            height: 64px;
            background: #ffffff;
            border-radius: 14px;

            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                text: root.checkout-status-text;
                color: #8a949a;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}
