import { Button, LineEdit } from "std-widgets.slint";

export component BillingDetailScreen inherits Rectangle {
    in property <string> plan-title: "暂未开通订阅";
    in property <string> balance-headline: "-- Token";
    in property <string> usage-caption: "登录后可查看剩余 Token、累计充值和累计消费。";
    in property <string> subscription-summary-text: "暂无订阅摘要";
    in property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in property <[string]> subscription-detail-lines: ["暂无订阅明细。"];
    in property <[string]> order-detail-lines: ["暂无订单明细。"];
    in property <[string]> history-lines: ["最近兑换记录会显示在这里。"];
    in-out property <string> redeem-code;
    in property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in-out property <string> recharge-amount: "";
    in property <[string]> payment-method-options: ["暂无可用支付方式"];
    in-out property <int> selected-payment-method-index: 0;
    in property <[string]> subscription-plan-options: ["暂无可用 OpenAI 套餐"];
    in-out property <int> selected-subscription-plan-index: 0;
    in property <string> checkout-status-text: "支付创建后会在这里显示状态。";

    callback redeem-requested();
    callback billing-recharge-requested();
    callback billing-subscription-requested();
    callback billing-open-last-payment-requested();
    callback billing-refresh-requested();

    background: #ffffff;
    border-radius: 12px;
    border-color: #dce6ef;
    border-width: 0px;

    property <length> content-width: self.width - 48px;
    property <length> left-width: self.width - 168px;
    in-out property <bool> future-open: false;

    Text {
        x: 24px;
        y: 20px;
        text: "计费中心";
        color: #2c3437;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 56px;
        width: parent.width - 48px;
        text: "当前以兑换 CDK 为主入口；余额充值、套餐购买与明细能力统一折叠到未来功能。";
        color: #596064;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: parent.width - 156px;
        y: 24px;
        width: 124px;
        height: 40px;
        future-touch := TouchArea { clicked => { root.future-open = !root.future-open; } }
        background: future-touch.pressed
            ? (root.future-open ? #00527d : #e2e8ed)
            : (root.future-open ? #006499 : #f0f4f7);
        border-radius: 20px;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.future-open ? "收起未来功能" : "未来功能";
            color: root.future-open ? #f6f9ff : #51616b;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 24px;
        y: 102px;
        width: root.left-width - 36px;
        height: parent.height - 126px;
        background: @linear-gradient(135deg, #fafdff 0%, #eef7fc 100%);
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 0px;

        Text {
            x: 24px;
            y: 22px;
            text: "兑换 CDK";
            color: #2c3437;
            font-size: 30px;
            font-weight: 800;
        }

        Text {
            x: 24px;
            y: 62px;
            width: parent.width - 48px;
            text: "输入兑换码后立即入账，是当前商业版默认开放的主要计费入口。";
            color: #596064;
            font-size: 13px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 24px;
            y: 112px;
            width: parent.width - 48px;
            height: 96px;
            background: #ffffff;
            border-radius: 18px;

            LineEdit {
                x: 18px;
                y: 22px;
                width: parent.width - 146px;
                height: 40px;
                text <=> root.redeem-code;
                placeholder-text: "输入 CDK";
            }

            Button {
                x: parent.width - 110px;
                y: 22px;
                width: 92px;
                height: 40px;
                text: "兑换 CDK";
                clicked => { root.redeem-requested(); }
            }

            Text {
                x: 18px;
                y: 70px;
                width: parent.width - 36px;
                text: root.redeem-status-text;
                color: #596064;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Text {
            x: 24px;
            y: 232px;
            text: "最近兑换记录";
            color: #2c3437;
            font-size: 18px;
            font-weight: 800;
        }

        for line[index] in root.history-lines : Rectangle {
            x: 24px;
            y: 266px + index * 68px;
            width: parent.width - 48px;
            height: 56px;
            background: #ffffff;
            border-radius: 14px;

            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                text: line;
                color: #596064;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    if root.future-open: Rectangle {
        x: root.left-width + 4px;
        y: 102px;
        width: parent.width - root.left-width - 28px;
        height: parent.height - 126px;
        background: #f7f9fb;
        border-radius: 22px;
        border-color: #dce6ef;
        border-width: 1px;

        Rectangle {
            x: 20px;
            y: 20px;
            width: 96px;
            height: 28px;
            background: #fff2e8;
            border-radius: 14px;
            Text {
                width: parent.width;
                height: parent.height;
                text: "暂未开放";
                color: #c6692a;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 20px;
            y: 62px;
            text: "未来功能";
            color: #2c3437;
            font-size: 22px;
            font-weight: 800;
        }

        Text {
            x: 20px;
            y: 98px;
            width: parent.width - 40px;
            text: "余额充值、套餐购买、订阅明细和订单明细已接好桌面端数据与回调，当前统一折叠，避免干扰主入口。";
            color: #596064;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 20px;
            y: 162px;
            width: parent.width - 40px;
            height: 74px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 14px; text: "余额充值"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 40px; width: parent.width - 32px; text: "后续恢复按 OpenAI 分组可用支付方式创建充值订单。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 248px;
            width: parent.width - 40px;
            height: 74px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 14px; text: "套餐购买"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 40px; width: parent.width - 32px; text: "后续恢复仅 OpenAI 套餐的选择、续费与付款页联动。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 334px;
            width: parent.width - 40px;
            height: 74px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 14px; text: "订阅明细"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 40px; width: parent.width - 32px; text: "后续展示 OpenAI 套餐额度、到期时间和订阅消耗。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: 420px;
            width: parent.width - 40px;
            height: 74px;
            background: #ffffff;
            border-radius: 14px;
            Text { x: 16px; y: 14px; text: "订单明细"; color: #2c3437; font-size: 16px; font-weight: 700; }
            Text { x: 16px; y: 40px; width: parent.width - 32px; text: "后续恢复订单列表、状态追踪和付款入口。"; color: #8a949a; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 20px;
            y: parent.height - 92px;
            width: parent.width - 40px;
            height: 64px;
            background: #ffffff;
            border-radius: 14px;
            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                text: root.checkout-status-text;
                color: #8a949a;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}
