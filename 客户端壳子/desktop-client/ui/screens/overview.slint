import { Button } from "std-widgets.slint";

export component OverviewScreen inherits Rectangle {
    in property <string> welcome-text: "准备开整";
    in property <string> user-label: "当前账号：未登录";
    in property <string> balance-text: "余额：--";
    in property <string> usage-text: "并发额度：--";
    in property <string> account-status-text: "账户状态：待登录";
    in property <string> notice-text: "一键开整";

    callback open-launch-requested();
    callback open-billing-requested();
    callback open-help-requested();

    background: transparent;

    // ─── Welcome Header ───
    Text {
        x: 0px; y: 0px;
        width: parent.width;
        text: "欢迎回来，开始您的精准编辑之旅。";
        color: #2c3437;
        font-size: 40px;
        font-weight: 800;
        wrap: word-wrap;
    }

    Text {
        x: 0px; y: 56px;
        text: "系统状态一切正常，准备就绪。";
        color: #596064;
        font-size: 18px;
    }

    // ─── Bento Grid: 8:4 ratio ───
    property <length> grid-y: 104px;
    property <length> grid-gap: 24px;
    property <length> col8-w: ((self.width - root.grid-gap) / 1px * 0.65) * 1px;
    property <length> col4-w: ((self.width - root.grid-gap) / 1px * 0.35) * 1px;

    // ── Card 1: 启动 Codex (col-span-8, primary action) ──
    Rectangle {
        x: 0px; y: root.grid-y;
        width: root.col8-w;
        height: 320px;
        background: #ffffff;
        border-radius: 12px;

        // Decorative corner accent (simulated)
        Rectangle {
            x: parent.width - 200px; y: 0px;
            width: 200px; height: 200px;
            background: #51b0f60d; // primary-container 5% opacity
            border-radius: 0px;
        }

        Text {
            x: 32px; y: 32px;
            text: "启动 Codex";
            color: #2c3437;
            font-size: 28px;
            font-weight: 700;
        }

        Text {
            x: 32px; y: 72px;
            width: parent.width - 64px;
            text: "进入高性能编辑环境，加载您最近的工作区配置，体验无缝的创作流程。";
            color: #596064;
            font-size: 14px;
            wrap: word-wrap;
        }

        // Primary CTA button
        Rectangle {
            x: parent.width - 168px;
            y: parent.height - 72px;
            width: 136px; height: 44px;
            background: #006499;
            border-radius: 4px;
            TouchArea { clicked => { root.open-launch-requested(); } }
            Text {
                width: parent.width; height: parent.height;
                text: "立即进入 →";
                color: #f6f9ff;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ── Card 2: 计费中心 (col-span-4) ──
    Rectangle {
        x: root.col8-w + root.grid-gap;
        y: root.grid-y;
        width: root.col4-w;
        height: 320px;
        background: #ffffff;
        border-radius: 12px;

        Text {
            x: 24px; y: 24px;
            text: "计费中心";
            color: #2c3437;
            font-size: 18px;
            font-weight: 700;
        }

        // Balance label
        Text {
            x: 24px; y: 72px;
            text: "当前余额";
            color: #51616b;
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            x: 24px; y: 90px;
            text: root.balance-text;
            color: #2c3437;
            font-size: 32px;
            font-weight: 800;
        }

        Text {
            x: 24px; y: 136px;
            text: root.usage-text;
            color: #596064;
            font-size: 12px;
        }

        // Action buttons
        Rectangle {
            x: 24px;
            y: parent.height - 64px;
            width: (parent.width - 72px) / 2;
            height: 36px;
            background: #bdece2; // secondary-container
            border-radius: 4px;
            TouchArea { clicked => { root.open-billing-requested(); } }
            Text {
                width: parent.width; height: parent.height;
                text: "充值";
                color: #2e5952;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: 24px + (parent.width - 72px) / 2 + 24px;
            y: parent.height - 64px;
            width: (parent.width - 72px) / 2;
            height: 36px;
            background: transparent;
            border-radius: 4px;
            border-color: #acb3b74d; // outline-variant 30%
            border-width: 1px;
            TouchArea { clicked => { root.open-billing-requested(); } }
            Text {
                width: parent.width; height: parent.height;
                text: "明细";
                color: #006499;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ── Card 3: 设置与帮助 (col-span-12, full width) ──
    Rectangle {
        x: 0px;
        y: root.grid-y + 320px + root.grid-gap;
        width: parent.width;
        height: 140px;
        background: #ffffff;
        border-radius: 12px;

        Text {
            x: 24px; y: 20px;
            text: "设置与帮助";
            color: #2c3437;
            font-size: 18px;
            font-weight: 700;
        }

        // Three action items in a row
        property <length> item-w: (self.width - 72px) / 3;

        Rectangle {
            x: 24px; y: 60px;
            width: parent.item-w; height: 60px;
            background: #f7f9fb;
            border-radius: 8px;
            TouchArea { clicked => { root.open-help-requested(); } }
            Text { x: 16px; y: 12px; text: "配置工作区"; color: #2c3437; font-size: 14px; font-weight: 600; }
            Text { x: 16px; y: 34px; text: "管理快捷键与界面偏好"; color: #596064; font-size: 12px; }
        }

        Rectangle {
            x: 36px + parent.item-w; y: 60px;
            width: parent.item-w; height: 60px;
            background: #f7f9fb;
            border-radius: 8px;
            TouchArea { clicked => { root.open-help-requested(); } }
            Text { x: 16px; y: 12px; text: "在线支持"; color: #2c3437; font-size: 14px; font-weight: 600; }
            Text { x: 16px; y: 34px; text: "联系技术顾问获取帮助"; color: #596064; font-size: 12px; }
        }

        Rectangle {
            x: 48px + parent.item-w * 2; y: 60px;
            width: parent.item-w; height: 60px;
            background: #f7f9fb;
            border-radius: 8px;
            TouchArea { clicked => { root.open-help-requested(); } }
            Text { x: 16px; y: 12px; text: "用户手册"; color: #2c3437; font-size: 14px; font-weight: 600; }
            Text { x: 16px; y: 34px; text: "查阅最新版本功能说明"; color: #596064; font-size: 12px; }
        }
    }

    // ── System Announcements Section ──
    Text {
        x: 8px;
        y: root.grid-y + 320px + root.grid-gap + 140px + 32px;
        text: "系统公告与日志";
        color: #51616b;
        font-size: 11px;
        font-weight: 600;
    }

    Rectangle {
        x: 0px;
        y: root.grid-y + 320px + root.grid-gap + 140px + 56px;
        width: parent.width;
        height: 140px;
        background: #ffffff;
        border-radius: 12px;

        // Announcement item 1
        Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: 46px;
            background: transparent;
            Text { x: 16px; y: 14px; text: "V2.4.0 核心组件更新说明"; color: #2c3437; font-size: 14px; font-weight: 500; }
            Text { x: parent.width - 100px; y: 16px; text: "今天 10:30"; color: #51616b; font-size: 12px; }
        }
        // Divider
        Rectangle { x: 16px; y: 46px; width: parent.width - 32px; height: 1px; background: #acb3b71a; }

        // Announcement item 2
        Rectangle {
            x: 0px; y: 47px;
            width: parent.width; height: 46px;
            background: transparent;
            Text { x: 16px; y: 14px; text: "工作区同步服务维护通知"; color: #2c3437; font-size: 14px; font-weight: 500; }
            Text { x: parent.width - 100px; y: 16px; text: "昨天 16:45"; color: #51616b; font-size: 12px; }
        }
        Rectangle { x: 16px; y: 93px; width: parent.width - 32px; height: 1px; background: #acb3b71a; }

        // Announcement item 3
        Rectangle {
            x: 0px; y: 94px;
            width: parent.width; height: 46px;
            background: transparent;
            Text { x: 16px; y: 14px; text: "您的计费账户已成功绑定"; color: #2c3437; font-size: 14px; font-weight: 500; }
            Text { x: parent.width - 100px; y: 16px; text: "2026-04-19"; color: #51616b; font-size: 12px; }
        }
    }
}
