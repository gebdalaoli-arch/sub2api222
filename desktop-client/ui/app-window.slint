import { Button } from "std-widgets.slint";
import { BrandPanel } from "components/brand_panel.slint";
import { AboutScreen } from "screens/about.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { ForgotPasswordScreen } from "screens/forgot_password.slint";
import { LaunchPanel } from "screens/launch_panel.slint";
import { RedeemScreen } from "screens/redeem.slint";
import { LoginScreen } from "screens/login.slint";

export component AppWindow inherits Window {
    width: 1280px;
    height: 860px;
    title: "一键开整";
    background: #edf3f8;

    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <string> reset-token;
    in-out property <string> new-password;

    in-out property <bool> desktop-available: false;
    in-out property <bool> cli-available: false;
    in-out property <string> launch-status-text: "尚未检测 Codex 安装";
    in-out property <string> auth-status-text: "请先登录以启用平台模式与账户同步。";
    in-out property <string> reset-status-text: "可先发送重置邮件，再填写邮件中的重置码。";
    in-out property <string> dashboard-user-label: "当前账号：未登录";
    in-out property <string> dashboard-balance-text: "余额：--";
    in-out property <string> dashboard-usage-text: "并发额度：--";
    in-out property <string> dashboard-account-status-text: "账户状态：待登录";
    in-out property <string> dashboard-notice-text: "充值页当前作为公告区。首版优先支持 CDK 兑换、订阅状态查看和平台模式启动。";
    in-out property <bool> remember-password: true;
    in-out property <bool> auto-login: false;
    in-out property <bool> show-login-totp: false;
    in-out property <string> brand-status-copy: "你的电子牛马已就位。";
    in-out property <string> redeem-code;
    in-out property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in-out property <string> subscription-summary-text: "暂无订阅摘要";
    in-out property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in-out property <[string]> order-lines: ["最近订单会显示在这里。"];
    in-out property <[string]> redeem-history-lines: ["最近兑换记录会显示在这里。"];
    in-out property <int> current-section: 0;
    in-out property <[string]> launch-group-options: ["登录后加载可用分组"];
    in-out property <int> launch-selected-group-index: 0;

    callback refresh-installations-requested();
    callback launch-desktop-requested();
    callback launch-cli-requested();
    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback login-requested();
    callback register-requested();
    callback verify-code-requested();
    callback forgot-password-requested();
    callback reset-password-requested();
    callback redeem-requested();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #edf3f8;

        Rectangle {
            x: 24px;
            y: 24px;
            width: 228px;
            height: parent.height - 48px;
            background: #f7fbff;
            border-radius: 26px;
            border-color: #d4e1ee;
            border-width: 1px;
        }

        Rectangle {
            x: 272px;
            y: 24px;
            width: parent.width - 296px;
            height: parent.height - 48px;
            background: #ffffff;
            border-radius: 26px;
            border-color: #d4e1ee;
            border-width: 1px;
        }

        Image {
            x: 46px;
            y: 44px;
            width: 58px;
            height: 58px;
            source: @image-url("../assets/app-icon.png");
        }

        Text {
            x: 116px;
            y: 52px;
            text: "一键开整";
            color: #18324a;
            font-size: 30px;
            font-weight: 800;
        }

        Text {
            x: 118px;
            y: 94px;
            width: 160px;
            text: "Windows 客户端";
            color: #587189;
            font-size: 13px;
        }

        Rectangle {
            x: 40px;
            y: 142px;
            width: 196px;
            height: 88px;
            background: #eef6ff;
            border-radius: 18px;
            border-color: #d5e4f7;
            border-width: 1px;

            Text {
                x: 18px;
                y: 16px;
                text: "交付模式";
                color: #22415c;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                x: 18px;
                y: 38px;
                width: 160px;
                text: "一键进入工作台，少折腾配置。账户、启动、计费仍然逐步下钻。";
                color: #64809a;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            x: 36px;
            y: 252px;
            width: 204px;
            height: 54px;
            background: root.current-section == 0 ? #18324a : #f7fbff;
            border-radius: 18px;
            border-color: root.current-section == 0 ? #18324a : #d6e3ef;
            border-width: 1px;
            TouchArea { clicked => { root.current-section = 0; } }
            Text { x: 18px; y: 12px; text: "账户中心"; color: root.current-section == 0 ? #ffffff : #18324a; font-size: 15px; font-weight: 700; }
            Text { x: 18px; y: 31px; width: 164px; text: "登录、注册、找回密码"; color: root.current-section == 0 ? #d7e6f6 : #6a8299; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 36px;
            y: 316px;
            width: 204px;
            height: 54px;
            background: root.current-section == 1 ? #18324a : #f7fbff;
            border-radius: 18px;
            border-color: root.current-section == 1 ? #18324a : #d6e3ef;
            border-width: 1px;
            TouchArea { clicked => { root.current-section = 1; } }
            Text { x: 18px; y: 12px; text: "启动中心"; color: root.current-section == 1 ? #ffffff : #18324a; font-size: 15px; font-weight: 700; }
            Text { x: 18px; y: 31px; width: 164px; text: "官方模式 / 平台代理"; color: root.current-section == 1 ? #d7e6f6 : #6a8299; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 36px;
            y: 380px;
            width: 204px;
            height: 54px;
            background: root.current-section == 2 ? #18324a : #f7fbff;
            border-radius: 18px;
            border-color: root.current-section == 2 ? #18324a : #d6e3ef;
            border-width: 1px;
            TouchArea { clicked => { root.current-section = 2; } }
            Text { x: 18px; y: 12px; text: "计费与公告"; color: root.current-section == 2 ? #ffffff : #18324a; font-size: 15px; font-weight: 700; }
            Text { x: 18px; y: 31px; width: 164px; text: "CDK、订阅、订单记录"; color: root.current-section == 2 ? #d7e6f6 : #6a8299; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 36px;
            y: 444px;
            width: 204px;
            height: 54px;
            background: root.current-section == 3 ? #18324a : #f7fbff;
            border-radius: 18px;
            border-color: root.current-section == 3 ? #18324a : #d6e3ef;
            border-width: 1px;
            TouchArea { clicked => { root.current-section = 3; } }
            Text { x: 18px; y: 12px; text: "帮助与安全"; color: root.current-section == 3 ? #ffffff : #18324a; font-size: 15px; font-weight: 700; }
            Text { x: 18px; y: 31px; width: 164px; text: "隐私、恢复、使用建议"; color: root.current-section == 3 ? #d7e6f6 : #6a8299; font-size: 11px; wrap: word-wrap; }
        }

        Text {
            x: 40px;
            y: parent.height - 194px;
            width: 184px;
            text: "不会显示连接密钥、服务地址或临时运行凭据。";
            color: #567089;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 40px;
            y: parent.height - 116px;
            width: 184px;
            height: 74px;
            background: #ffffff;
            border-radius: 18px;
            border-color: #d6e3ef;
            border-width: 1px;
            Text { x: 16px; y: 14px; text: "v0.1.0"; color: #18324a; font-size: 13px; font-weight: 700; }
            Text { x: 16px; y: 34px; width: 150px; text: "Windows 安装包、账户闭环和平台代理模式已接通。"; color: #698198; font-size: 11px; wrap: word-wrap; }
        }

        Rectangle {
            x: 304px;
            y: 44px;
            width: parent.width - 360px;
            height: 108px;
            background: #f7fbff;
            border-radius: 20px;
            border-color: #d7e4f0;
            border-width: 1px;

            Text {
                x: 24px;
                y: 18px;
                text: root.current-section == 0 ? "账户中心" : root.current-section == 1 ? "启动中心" : root.current-section == 2 ? "计费与公告" : "帮助与安全";
                color: #18324a;
                font-size: 28px;
                font-weight: 800;
            }

            Text {
                x: 24px;
                y: 50px;
                width: parent.width - 280px;
                text: root.current-section == 0 ? root.auth-status-text : root.current-section == 1 ? root.launch-status-text : root.current-section == 2 ? root.dashboard-notice-text : "平台模式与官方模式相互隔离，帮助信息集中在这里。";
                color: #698198;
                font-size: 13px;
                wrap: word-wrap;
            }

            Rectangle {
                x: parent.width - 224px;
                y: 20px;
                width: 88px;
                height: 30px;
                background: root.dashboard-user-label == "当前账号：未登录" ? #f2f5f8 : #eaf8ef;
                border-radius: 14px;
                border-color: root.dashboard-user-label == "当前账号：未登录" ? #d7e4f0 : #cce6d4;
                border-width: 1px;
                Text { x: 14px; y: 8px; text: root.dashboard-user-label == "当前账号：未登录" ? "账户未登录" : "账户已登录"; color: root.dashboard-user-label == "当前账号：未登录" ? #6d8398 : #2d6a42; font-size: 11px; font-weight: 700; }
            }

            Rectangle {
                x: parent.width - 124px;
                y: 20px;
                width: 88px;
                height: 30px;
                background: root.desktop-available || root.cli-available ? #edf5ff : #f2f5f8;
                border-radius: 14px;
                border-color: root.desktop-available || root.cli-available ? #cfe0f2 : #d7e4f0;
                border-width: 1px;
                Text { x: 14px; y: 8px; text: root.desktop-available || root.cli-available ? "启动已就绪" : "等待检测"; color: root.desktop-available || root.cli-available ? #2b587f : #6d8398; font-size: 11px; font-weight: 700; }
            }
        }

        if root.current-section == 0: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            BrandPanel {
                x: 0px;
                y: 0px;
                width: 352px;
                height: parent.height;
                product-name: "一键开整";
                status-copy: root.brand-status-copy;
            }

            LoginScreen {
                x: 376px;
                y: 0px;
                width: parent.width - 376px;
                email <=> root.email;
                password <=> root.password;
                verification-code <=> root.verification-code;
                remember-password <=> root.remember-password;
                auto-login <=> root.auto-login;
                show-totp-field: root.show-login-totp;
                status-text: root.auth-status-text;
                login-requested => { root.login-requested(); }
                register-requested => { root.register-requested(); }
                verify-code-requested => { root.verify-code-requested(); }
            }
        }

        if root.current-section == 1: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            LaunchPanel {
                x: 0px;
                y: 0px;
                width: 460px;
                height: 420px;
                desktop-available: root.desktop-available;
                cli-available: root.cli-available;
                status-text: root.launch-status-text;
                group-options: root.launch-group-options;
                selected-group-index <=> root.launch-selected-group-index;
                refresh-requested => { root.refresh-installations-requested(); }
                launch-desktop-requested => { root.launch-desktop-requested(); }
                launch-cli-requested => { root.launch-cli-requested(); }
                launch-platform-desktop-requested => { root.launch-platform-desktop-requested(); }
                launch-platform-cli-requested => { root.launch-platform-cli-requested(); }
            }

            Rectangle {
                x: 484px;
                y: 0px;
                width: parent.width - 484px;
                height: 420px;
                background: #f8fbff;
                border-radius: 24px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 22px;
                    y: 20px;
                    text: "模式说明";
                    color: #18324a;
                    font-size: 22px;
                    font-weight: 800;
                }

                Text {
                    x: 24px;
                    y: 58px;
                    width: parent.width - 48px;
                    text: "官方模式不改你的官方配置；平台模式会为本次启动生成独立受管 home、独立运行目录和临时会话。";
                    color: #688097;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle {
                    x: 24px;
                    y: 120px;
                    width: parent.width - 48px;
                    height: 72px;
                    background: #ffffff;
                    border-radius: 18px;
                    border-color: #d7e4f0;
                    border-width: 1px;

                    Text {
                        x: 16px;
                        y: 14px;
                        text: "官方模式";
                        color: #21435f;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text {
                        x: 16px;
                        y: 36px;
                        width: parent.width - 32px;
                        text: "用于平台异常时保底启动。不会写 CODEX_HOME，不会注入平台连接。";
                        color: #698198;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    x: 24px;
                    y: 208px;
                    width: parent.width - 48px;
                    height: 180px;
                    background: #ffffff;
                    border-radius: 18px;
                    border-color: #d7e4f0;
                    border-width: 1px;

                    Text {
                        x: 16px;
                        y: 14px;
                        text: "平台代理模式";
                        color: #21435f;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text {
                        x: 16px;
                        y: 36px;
                        width: parent.width - 32px;
                        text: "登录后会按所选 group_id 创建 desktop session，写入本次启动专属的受管 home，再启动本次 Codex 进程。";
                        color: #698198;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text {
                        x: 16px;
                        y: 98px;
                        width: parent.width - 32px;
                        text: "如果当前分组无权限、订阅失效或会话创建失败，客户端应明确显示原因，并允许你直接退回官方模式。";
                        color: #698198;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            AboutScreen {
                x: 0px;
                y: 444px;
                width: parent.width;
                height: 116px;
            }
        }

        if root.current-section == 2: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            RedeemScreen {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                redeem-code <=> root.redeem-code;
                redeem-status-text: root.redeem-status-text;
                subscription-summary-text: root.subscription-summary-text;
                subscription-lines: root.subscription-lines;
                order-lines: root.order-lines;
                history-lines: root.redeem-history-lines;
                redeem-requested => { root.redeem-requested(); }
            }
        }

        if root.current-section == 3: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            AboutScreen {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 112px;
            }

            Rectangle {
                x: 0px;
                y: 132px;
                width: parent.width;
                height: 214px;
                background: #f8fbff;
                border-radius: 24px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 24px;
                    y: 20px;
                    text: "使用建议";
                    color: #18324a;
                    font-size: 22px;
                    font-weight: 800;
                }

                Text { x: 24px; y: 62px; text: "1. 先登录并确认账户套餐可用，再进入平台模式。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 88px; text: "2. 如遇启动失败，优先检测安装，再查看模式说明与账户状态。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 114px; text: "3. 如遇强退，下次启动会优先清理临时运行材料，官方模式不受影响。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 140px; text: "4. 客户端不会展示普通 API 凭据，也不会要求你手动复制网关地址。"; color: #57708a; font-size: 13px; }
            }
        }
    }
}
