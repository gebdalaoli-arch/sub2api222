import { Button } from "std-widgets.slint";
import { AboutScreen } from "screens/about.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { ForgotPasswordScreen } from "screens/forgot_password.slint";
import { LaunchPanel } from "screens/launch_panel.slint";
import { LoginScreen } from "screens/login.slint";

export component AppWindow inherits Window {
    width: 1180px;
    height: 820px;
    title: "Token Client";
    background: #f4eddd;

    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <string> reset-token;
    in-out property <string> new-password;
    in-out property <bool> desktop-available: false;
    in-out property <bool> cli-available: false;
    in-out property <string> launch-status-text: "尚未检测 Codex 安装";

    callback refresh-installations-requested();
    callback launch-desktop-requested();
    callback launch-cli-requested();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f4eddd;

        Rectangle {
            x: 28px;
            y: 28px;
            width: parent.width - 56px;
            height: parent.height - 56px;
            background: #fff9eb;
            border-radius: 28px;
            border-color: #243324;
            border-width: 1px;
        }

        Rectangle {
            x: parent.width - 370px;
            y: 28px;
            width: 342px;
            height: parent.height - 56px;
            background: #18251f;
            border-radius: 28px;
        }

        Text {
            x: 68px;
            y: 62px;
            text: "Token Client";
            color: #17251e;
            font-size: 44px;
            font-weight: 800;
        }

        Text {
            x: 72px;
            y: 118px;
            width: 650px;
            text: "给 Sub2API 用户准备的 Codex 启动台。隐藏接口细节，只保留登录、兑换和一键启动。";
            color: #5e684f;
            font-size: 18px;
            wrap: word-wrap;
        }

        LoginScreen {
            x: 72px;
            y: 178px;
            width: 438px;
            email <=> root.email;
            password <=> root.password;
            verification-code <=> root.verification-code;
            status-text: "未连接。登录成功后再创建临时桌面会话。";
        }

        DashboardScreen {
            x: 534px;
            y: 178px;
            width: 290px;
            user-label: "当前账号：未登录";
            balance-text: "余额：--";
            usage-text: "并发额度：--";
            recharge-notice: "充值页面暂作为公告页。首版先支持 CDK 兑换，不在客户端展示接口地址或密钥。";
        }

        ForgotPasswordScreen {
            x: 72px;
            y: 582px;
            width: 752px;
            email <=> root.email;
            reset-token <=> root.reset-token;
            new-password <=> root.new-password;
        }

        Text {
            x: parent.width - 322px;
            y: 72px;
            width: 250px;
            text: "不会暴露连接凭证";
            color: #f6ead1;
            font-size: 28px;
            font-weight: 800;
            wrap: word-wrap;
        }

        Text {
            x: parent.width - 322px;
            y: 166px;
            width: 250px;
            text: "平台连接、官方订阅、本地历史三者隔离。出错时优先保护官方环境，平台坏了官方还能用。";
            color: #c8d2b7;
            font-size: 16px;
            wrap: word-wrap;
        }

        Rectangle {
            x: parent.width - 322px;
            y: 278px;
            width: 246px;
            height: 112px;
            background: #24382f;
            border-radius: 22px;

            Text { x: 22px; y: 18px; text: "启动策略"; color: #f6ead1; font-size: 20px; font-weight: 800; }
            Text { x: 22px; y: 54px; width: 202px; text: "官方模式：不改官方配置。平台模式：为本次启动生成独立临时环境。"; color: #c8d2b7; font-size: 14px; wrap: word-wrap; }
        }

        LaunchPanel {
            x: parent.width - 322px;
            y: 420px;
            width: 246px;
            desktop-available: root.desktop-available;
            cli-available: root.cli-available;
            status-text: root.launch-status-text;
            refresh-requested => { root.refresh-installations-requested(); }
            launch-desktop-requested => { root.launch-desktop-requested(); }
            launch-cli-requested => { root.launch-cli-requested(); }
        }

        AboutScreen {
            x: parent.width - 322px;
            y: parent.height - 204px;
            width: 246px;
        }
    }
}
