import { Button } from "std-widgets.slint";
import { AboutScreen } from "screens/about.slint";
import { DashboardScreen } from "screens/dashboard.slint";
import { ForgotPasswordScreen } from "screens/forgot_password.slint";
import { LaunchPanel } from "screens/launch_panel.slint";
import { LoginScreen } from "screens/login.slint";

export component AppWindow inherits Window {
    width: 1280px;
    height: 860px;
    title: "Sub2API Desktop Client";
    background: #edf3f8;

    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in-out property <string> reset-token;
    in-out property <string> new-password;

    in-out property <bool> desktop-available: false;
    in-out property <bool> cli-available: false;
    in-out property <string> launch-status-text: "尚未检测 Codex 安装";
    in-out property <string> auth-status-text: "请先登录以启用平台模式与账户同步。";
    in-out property <string> reset-status-text: "可先发送重置邮件，再填写邮件中的重置码。";
    in-out property <string> dashboard-user-label: "当前账号：未登录";
    in-out property <string> dashboard-balance-text: "余额：--";
    in-out property <string> dashboard-usage-text: "并发额度：--";
    in-out property <string> dashboard-account-status-text: "账户状态：待登录";
    in-out property <string> dashboard-notice-text: "充值页当前作为公告区。首版优先支持 CDK 兑换、订阅状态查看和平台模式启动。";
    in-out property <int> current-section: 0;

    callback refresh-installations-requested();
    callback launch-desktop-requested();
    callback launch-cli-requested();
    callback login-requested();
    callback register-requested();
    callback verify-code-requested();
    callback forgot-password-requested();
    callback reset-password-requested();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #edf3f8;

        Rectangle {
            x: 24px;
            y: 24px;
            width: 228px;
            height: parent.height - 48px;
            background: #f8fbfe;
            border-radius: 26px;
            border-color: #d4e1ee;
            border-width: 1px;
        }

        Rectangle {
            x: 272px;
            y: 24px;
            width: parent.width - 296px;
            height: parent.height - 48px;
            background: #ffffff;
            border-radius: 26px;
            border-color: #d4e1ee;
            border-width: 1px;
        }

        Text {
            x: 52px;
            y: 54px;
            text: "Sub2API";
            color: #18324a;
            font-size: 30px;
            font-weight: 800;
        }

        Text {
            x: 52px;
            y: 94px;
            width: 160px;
            text: "Desktop Client";
            color: #5c7388;
            font-size: 14px;
        }

        Rectangle {
            x: 52px;
            y: 138px;
            width: 168px;
            height: 76px;
            background: #eef6ff;
            border-radius: 18px;
            border-color: #d5e4f7;
            border-width: 1px;

            Text {
                x: 16px;
                y: 16px;
                text: "交付模式";
                color: #22415c;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                x: 16px;
                y: 38px;
                width: 136px;
                text: "亮色原生桌面壳。默认优先官方模式，平台模式独立隔离。";
                color: #64809a;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Button {
            x: 44px;
            y: 246px;
            width: 188px;
            height: 42px;
            text: "账户中心";
            clicked => { root.current-section = 0; }
        }

        Button {
            x: 44px;
            y: 298px;
            width: 188px;
            height: 42px;
            text: "启动中心";
            clicked => { root.current-section = 1; }
        }

        Button {
            x: 44px;
            y: 350px;
            width: 188px;
            height: 42px;
            text: "计费与公告";
            clicked => { root.current-section = 2; }
        }

        Button {
            x: 44px;
            y: 402px;
            width: 188px;
            height: 42px;
            text: "帮助与安全";
            clicked => { root.current-section = 3; }
        }

        Text {
            x: 52px;
            y: parent.height - 176px;
            width: 168px;
            text: "不会显示连接密钥、服务地址或临时运行凭据。";
            color: #567089;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            x: 304px;
            y: 44px;
            width: parent.width - 360px;
            height: 84px;
            background: #f8fbff;
            border-radius: 20px;
            border-color: #d7e4f0;
            border-width: 1px;

            Text {
                x: 24px;
                y: 18px;
                text: root.current-section == 0 ? "账户中心" : root.current-section == 1 ? "启动中心" : root.current-section == 2 ? "计费与公告" : "帮助与安全";
                color: #18324a;
                font-size: 28px;
                font-weight: 800;
            }

            Text {
                x: 24px;
                y: 50px;
                width: parent.width - 48px;
                text: root.current-section == 0 ? root.auth-status-text : root.current-section == 1 ? root.launch-status-text : root.current-section == 2 ? root.dashboard-notice-text : "平台模式与官方模式相互隔离，帮助信息集中在这里。";
                color: #698198;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        if root.current-section == 0: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            LoginScreen {
                x: 0px;
                y: 0px;
                width: 460px;
                email <=> root.email;
                password <=> root.password;
                verification-code <=> root.verification-code;
                status-text: root.auth-status-text;
                login-requested => { root.login-requested(); }
                register-requested => { root.register-requested(); }
                verify-code-requested => { root.verify-code-requested(); }
            }

            DashboardScreen {
                x: 484px;
                y: 0px;
                width: parent.width - 484px;
                user-label: root.dashboard-user-label;
                balance-text: root.dashboard-balance-text;
                usage-text: root.dashboard-usage-text;
                account-status-text: root.dashboard-account-status-text;
                recharge-notice: root.dashboard-notice-text;
                launch-requested => { root.current-section = 1; }
            }

            ForgotPasswordScreen {
                x: 0px;
                y: 396px;
                width: parent.width;
                email <=> root.email;
                reset-token <=> root.reset-token;
                new-password <=> root.new-password;
                status-text: root.reset-status-text;
                forgot-password-requested => { root.forgot-password-requested(); }
                reset-password-requested => { root.reset-password-requested(); }
            }
        }

        if root.current-section == 1: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            LaunchPanel {
                x: 0px;
                y: 0px;
                width: 460px;
                height: 320px;
                desktop-available: root.desktop-available;
                cli-available: root.cli-available;
                status-text: root.launch-status-text;
                refresh-requested => { root.refresh-installations-requested(); }
                launch-desktop-requested => { root.launch-desktop-requested(); }
                launch-cli-requested => { root.launch-cli-requested(); }
            }

            Rectangle {
                x: 484px;
                y: 0px;
                width: parent.width - 484px;
                height: 320px;
                background: #f8fbff;
                border-radius: 24px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 22px;
                    y: 20px;
                    text: "模式说明";
                    color: #18324a;
                    font-size: 22px;
                    font-weight: 800;
                }

                Text {
                    x: 24px;
                    y: 58px;
                    width: parent.width - 48px;
                    text: "官方模式不改你的官方配置；平台模式会为本次启动生成独立受管 home、独立运行目录和临时会话。";
                    color: #688097;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle {
                    x: 24px;
                    y: 120px;
                    width: parent.width - 48px;
                    height: 72px;
                    background: #ffffff;
                    border-radius: 18px;
                    border-color: #d7e4f0;
                    border-width: 1px;

                    Text {
                        x: 16px;
                        y: 14px;
                        text: "官方模式";
                        color: #21435f;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text {
                        x: 16px;
                        y: 36px;
                        width: parent.width - 32px;
                        text: "用于平台异常时保底启动。不会写 CODEX_HOME，不会注入平台连接。";
                        color: #698198;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    x: 24px;
                    y: 208px;
                    width: parent.width - 48px;
                    height: 86px;
                    background: #ffffff;
                    border-radius: 18px;
                    border-color: #d7e4f0;
                    border-width: 1px;

                    Text {
                        x: 16px;
                        y: 14px;
                        text: "平台代理模式";
                        color: #21435f;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text {
                        x: 16px;
                        y: 36px;
                        width: parent.width - 32px;
                        text: "接下来会绑定 group_id、桌面会话和独立 runtime 目录。当前优先完成安装检测、账户闭环与启动编排。";
                        color: #698198;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            AboutScreen {
                x: 0px;
                y: 344px;
                width: parent.width;
                height: 116px;
            }
        }

        if root.current-section == 2: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 184px;
                background: #f8fbff;
                border-radius: 24px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 24px;
                    y: 20px;
                    text: "CDK 与充值公告";
                    color: #18324a;
                    font-size: 24px;
                    font-weight: 800;
                }

                Text {
                    x: 24px;
                    y: 58px;
                    width: parent.width - 48px;
                    text: "首版先保留公告形态。这里用于展示套餐说明、CDK 兑换入口、订阅限制与维护通知。";
                    color: #688097;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Rectangle {
                    x: 24px;
                    y: 108px;
                    width: parent.width - 48px;
                    height: 54px;
                    background: #ffffff;
                    border-radius: 16px;
                    border-color: #d7e4f0;
                    border-width: 1px;

                    Text {
                        x: 16px;
                        y: 18px;
                        width: parent.width - 32px;
                        text: root.dashboard-notice-text;
                        color: #567089;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            DashboardScreen {
                x: 0px;
                y: 204px;
                width: parent.width;
                height: 280px;
                user-label: root.dashboard-user-label;
                balance-text: root.dashboard-balance-text;
                usage-text: root.dashboard-usage-text;
                account-status-text: root.dashboard-account-status-text;
                recharge-notice: "CDK 兑换和订阅公告将在这个工作区持续展示，后续会补订单明细和最近操作。";
                launch-requested => { root.current-section = 1; }
            }
        }

        if root.current-section == 3: Rectangle {
            x: 304px;
            y: 148px;
            width: parent.width - 360px;
            height: parent.height - 196px;
            background: transparent;

            AboutScreen {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 112px;
            }

            Rectangle {
                x: 0px;
                y: 132px;
                width: parent.width;
                height: 214px;
                background: #f8fbff;
                border-radius: 24px;
                border-color: #d7e4f0;
                border-width: 1px;

                Text {
                    x: 24px;
                    y: 20px;
                    text: "使用建议";
                    color: #18324a;
                    font-size: 22px;
                    font-weight: 800;
                }

                Text { x: 24px; y: 62px; text: "1. 先登录并确认账户套餐可用，再进入平台模式。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 88px; text: "2. 如遇启动失败，优先检测安装，再查看模式说明与账户状态。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 114px; text: "3. 如遇强退，下次启动会优先清理临时运行材料，官方模式不受影响。"; color: #57708a; font-size: 13px; }
                Text { x: 24px; y: 140px; text: "4. 客户端不会展示普通 API 凭据，也不会要求你手动复制网关地址。"; color: #57708a; font-size: 13px; }
            }
        }
    }
}
