import { Button } from "std-widgets.slint";

export component DashboardScreen inherits Rectangle {
    in property <string> balance-text: "余额：--";
    in property <string> usage-text: "并发额度：--";
    in property <string> recharge-notice: "充值页面暂作为公告页，首版仅支持 CDK 兑换。";
    in property <string> user-label: "未登录";

    callback redeem-requested();
    callback launch-requested();

    height: 372px;
    background: #eef3dc;
    border-radius: 28px;

    Text {
        x: 26px;
        y: 24px;
        text: "账户总览";
        color: #17251e;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 28px;
        y: 66px;
        text: root.user-label;
        color: #607052;
        font-size: 14px;
    }

    Rectangle {
        x: 26px;
        y: 106px;
        width: parent.width - 52px;
        height: 82px;
        background: #17251e;
        border-radius: 22px;

        Text {
            x: 22px;
            y: 18px;
            text: root.balance-text;
            color: #fff4dd;
            font-size: 24px;
            font-weight: 800;
        }

        Text {
            x: 22px;
            y: 52px;
            text: root.usage-text;
            color: #cbd7bd;
            font-size: 14px;
        }
    }

    Text {
        x: 28px;
        y: 216px;
        width: parent.width - 56px;
        text: root.recharge-notice;
        color: #4b5944;
        font-size: 14px;
        wrap: word-wrap;
    }

    Button {
        x: 28px;
        y: 292px;
        width: 128px;
        height: 44px;
        text: "兑换 CDK";
        clicked => { root.redeem-requested(); }
    }

    Button {
        x: 172px;
        y: 292px;
        width: 152px;
        height: 44px;
        text: "启动 Codex";
        clicked => { root.launch-requested(); }
    }
}
