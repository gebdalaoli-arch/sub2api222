import { Button, LineEdit } from "std-widgets.slint";

export component RedeemScreen inherits Rectangle {
    in-out property <string> redeem-code;
    in property <string> redeem-status-text: "输入 CDK 后点击兑换。";
    in property <string> subscription-summary-text: "暂无订阅摘要";
    in property <[string]> subscription-lines: ["登录后可查看当前订阅额度和到期时间。"];
    in property <[string]> order-lines: ["最近订单会显示在这里。"];
    in property <[string]> history-lines: ["最近兑换记录会显示在这里。"];

    callback redeem-requested();

    background: #ffffff;
    border-radius: 24px;
    border-color: #dce6ef;
    border-width: 1px;

    Text {
        x: 24px;
        y: 20px;
        text: "计费详情";
        color: #18324a;
        font-size: 28px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 56px;
        width: parent.width - 48px;
        text: "查看当前订阅、消费摘要、历史订单和兑换记录。";
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: 24px;
        y: 96px;
        width: parent.width;
        height: 138px;
        background: @linear-gradient(135deg, #fafdff 0%, #eef7fc 100%);
        border-radius: 28px;
        border-color: #dae8f2;
        border-width: 1px;

        Text {
            x: 20px;
            y: 18px;
            text: "订阅摘要";
            color: #21435f;
            font-size: 16px;
            font-weight: 700;
        }

        Text {
            x: 20px;
            y: 46px;
            width: parent.width - 40px;
            text: root.subscription-summary-text;
            color: #18324a;
            font-size: 20px;
            font-weight: 800;
            wrap: word-wrap;
        }

        Rectangle {
            x: parent.width - 188px;
            y: 22px;
            width: 156px;
            height: 42px;
            background: #ffffff;
            border-radius: 18px;
            border-color: #d7e4f0;
            border-width: 1px;

            Text {
                x: 18px;
                y: 12px;
                text: "账户余额概览";
                color: #2b59d0;
                font-size: 12px;
                font-weight: 700;
            }
        }

        Rectangle {
            x: 20px;
            y: 92px;
            width: 164px;
            height: 28px;
            background: #ffffff;
            border-radius: 14px;
            border-color: #d7e4f0;
            border-width: 1px;
            Text { x: 16px; y: 7px; text: "订阅项目 " + root.subscription-lines.length; color: #6a8299; font-size: 11px; font-weight: 700; }
        }

        Rectangle {
            x: 196px;
            y: 92px;
            width: 164px;
            height: 28px;
            background: #ffffff;
            border-radius: 14px;
            border-color: #d7e4f0;
            border-width: 1px;
            Text { x: 16px; y: 7px; text: "历史订单 " + root.order-lines.length; color: #6a8299; font-size: 11px; font-weight: 700; }
        }

        Rectangle {
            x: 372px;
            y: 92px;
            width: 164px;
            height: 28px;
            background: #ffffff;
            border-radius: 14px;
            border-color: #d7e4f0;
            border-width: 1px;
            Text { x: 16px; y: 7px; text: "兑换记录 " + root.history-lines.length; color: #6a8299; font-size: 11px; font-weight: 700; }
        }
    }

    Rectangle {
        x: 24px;
        y: 254px;
        width: parent.width;
        height: 82px;
        background: #f8fbff;
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 1px;

        LineEdit {
            x: 18px;
            y: 20px;
            width: parent.width - 160px;
            height: 42px;
            text <=> root.redeem-code;
            placeholder-text: "输入 CDK";
        }

        Button {
            x: parent.width - 118px;
            y: 20px;
            width: 96px;
            height: 42px;
            text: "兑换 CDK";
            clicked => { root.redeem-requested(); }
        }
    }

    Rectangle {
        x: 24px;
        y: 354px;
        width: parent.width;
        height: 54px;
        background: #ffffff;
        border-radius: 16px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text {
            x: 16px;
            y: 18px;
            width: parent.width - 32px;
            text: root.redeem-status-text;
            color: #5b7490;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: 24px;
        y: 428px;
        width: parent.width - 300px;
        height: parent.height - 452px;
        background: #f8fbff;
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text {
            x: 18px;
            y: 18px;
            text: "历史订单";
            color: #18324a;
            font-size: 20px;
            font-weight: 800;
        }

        for line[index] in root.order-lines : Rectangle {
            x: 18px;
            y: 56px + index * 72px;
            width: parent.width - 36px;
            height: 58px;
            background: #ffffff;
            border-radius: 18px;
            border-color: #d7e4f0;
            border-width: 1px;

            Text {
                x: 16px;
                y: 18px;
                width: parent.width - 32px;
                text: line;
                color: #688097;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    Rectangle {
        x: parent.width - 260px;
        y: 428px;
        width: 236px;
        height: parent.height - 452px;
        background: #f8fbff;
        border-radius: 22px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text {
            x: 18px;
            y: 18px;
            text: "兑换记录";
            color: #18324a;
            font-size: 18px;
            font-weight: 800;
        }

        for line[index] in root.history-lines : Rectangle {
            x: 18px;
            y: 52px + index * 70px;
            width: parent.width - 36px;
            height: 56px;
            background: #ffffff;
            border-radius: 18px;
            border-color: #d7e4f0;
            border-width: 1px;

            Text {
                x: 14px;
                y: 16px;
                width: parent.width - 28px;
                text: line;
                color: #688097;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
