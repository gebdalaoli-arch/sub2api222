import { Button, ComboBox } from "std-widgets.slint";

export component LaunchPanel inherits Rectangle {
    in property <bool> desktop-available: false;
    in property <bool> cli-available: false;
    in property <string> status-text: "尚未检测 Codex 安装";
    in property <[string]> group-options: ["登录后加载可用分组"];
    in-out property <int> selected-group-index: 0;

    callback launch-desktop-requested();
    callback launch-cli-requested();
    callback launch-platform-desktop-requested();
    callback launch-platform-cli-requested();
    callback refresh-requested();

    background: #f8fbff;
    border-radius: 24px;
    border-color: #d7e4f0;
    border-width: 1px;

    Text {
        x: 24px;
        y: 20px;
        text: "启动中心";
        color: #18324a;
        font-size: 24px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: root.status-text;
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        x: parent.width - 114px;
        y: 18px;
        width: 90px;
        height: 30px;
        background: #eef6ff;
        border-radius: 14px;
        border-color: #d5e4f7;
        border-width: 1px;
        Text { x: 16px; y: 8px; text: "双模式"; color: #315577; font-size: 11px; font-weight: 700; }
    }

    Rectangle {
        x: 24px;
        y: 98px;
        width: parent.width - 48px;
        height: 72px;
        background: #ffffff;
        border-radius: 18px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text { x: 16px; y: 14px; text: "Codex Desktop"; color: #24415c; font-size: 15px; font-weight: 700; }
        Text { x: 16px; y: 38px; text: root.desktop-available ? "已检测到可启动目标" : "未检测到可用 Desktop"; color: #688097; font-size: 12px; }
        Rectangle {
            x: parent.width - 86px;
            y: 20px;
            width: 62px;
            height: 24px;
            background: root.desktop-available ? #eaf8ef : #f2f5f8;
            border-radius: 12px;
            border-color: root.desktop-available ? #cce6d4 : #d7e4f0;
            border-width: 1px;
            Text { x: 14px; y: 6px; text: root.desktop-available ? "就绪" : "缺失"; color: root.desktop-available ? #2d6a42 : #6d8398; font-size: 10px; font-weight: 700; }
        }
    }

    Rectangle {
        x: 24px;
        y: 182px;
        width: parent.width - 48px;
        height: 72px;
        background: #ffffff;
        border-radius: 18px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text { x: 16px; y: 14px; text: "Codex CLI"; color: #24415c; font-size: 15px; font-weight: 700; }
        Text { x: 16px; y: 38px; text: root.cli-available ? "已检测到可启动目标" : "未检测到可用 CLI"; color: #688097; font-size: 12px; }
        Rectangle {
            x: parent.width - 86px;
            y: 20px;
            width: 62px;
            height: 24px;
            background: root.cli-available ? #eaf8ef : #f2f5f8;
            border-radius: 12px;
            border-color: root.cli-available ? #cce6d4 : #d7e4f0;
            border-width: 1px;
            Text { x: 14px; y: 6px; text: root.cli-available ? "就绪" : "缺失"; color: root.cli-available ? #2d6a42 : #6d8398; font-size: 10px; font-weight: 700; }
        }
    }

    Text {
        x: 24px;
        y: 270px;
        text: "平台代理模式";
        color: #18324a;
        font-size: 17px;
        font-weight: 700;
    }

    Text {
        x: 24px;
        y: 294px;
        width: parent.width - 48px;
        text: "登录后选择可用分组，再为本次启动创建独立受管 home。";
        color: #688097;
        font-size: 12px;
        wrap: word-wrap;
    }

    ComboBox {
        x: 24px;
        y: 326px;
        width: parent.width - 48px;
        height: 40px;
        model: root.group-options;
        current-index <=> root.selected-group-index;
    }

    Button {
        x: 24px;
        y: parent.height - 104px;
        width: 120px;
        height: 40px;
        text: "检测安装";
        clicked => { root.refresh-requested(); }
    }

    Button {
        x: 158px;
        y: parent.height - 104px;
        width: 130px;
        height: 40px;
        text: "启动 Desktop";
        enabled: root.desktop-available;
        clicked => { root.launch-desktop-requested(); }
    }

    Button {
        x: 302px;
        y: parent.height - 104px;
        width: 118px;
        height: 40px;
        text: "启动 CLI";
        enabled: root.cli-available;
        clicked => { root.launch-cli-requested(); }
    }

    Button {
        x: 24px;
        y: parent.height - 56px;
        width: 192px;
        height: 40px;
        text: "平台模式 Desktop";
        enabled: root.desktop-available;
        clicked => { root.launch-platform-desktop-requested(); }
    }

    Button {
        x: 228px;
        y: parent.height - 56px;
        width: 192px;
        height: 40px;
        text: "平台模式 CLI";
        enabled: root.cli-available;
        clicked => { root.launch-platform-cli-requested(); }
    }
}
