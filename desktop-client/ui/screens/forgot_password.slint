import { Button, LineEdit } from "std-widgets.slint";

export component ForgotPasswordScreen inherits Rectangle {
    in-out property <string> email;
    in-out property <string> reset-token;
    in-out property <string> new-password;
    in property <string> status-text: "输入邮箱后发送重置邮件";

    callback forgot-password-requested();
    callback reset-password-requested();

    height: 220px;
    background: #fbf2dd;
    border-radius: 24px;
    border-color: #d8c9a6;
    border-width: 1px;

    Text {
        x: 24px;
        y: 20px;
        text: "忘记密码";
        color: #17251e;
        font-size: 22px;
        font-weight: 800;
    }

    Text {
        x: 26px;
        y: 54px;
        width: parent.width - 52px;
        text: "首版先接邮箱重置流程；如果平台关闭重置，客户端会显示平台公告。";
        color: #607052;
        font-size: 13px;
        wrap: word-wrap;
    }

    LineEdit {
        x: 24px;
        y: 94px;
        width: parent.width - 160px;
        height: 40px;
        text <=> root.email;
        placeholder-text: "邮箱";
    }

    Button {
        x: parent.width - 124px;
        y: 94px;
        width: 100px;
        height: 40px;
        text: "发送";
        clicked => { root.forgot-password-requested(); }
    }

    LineEdit {
        x: 24px;
        y: 146px;
        width: (parent.width - 72px) / 2;
        height: 40px;
        text <=> root.reset-token;
        placeholder-text: "邮件重置码";
    }

    LineEdit {
        x: 48px + (parent.width - 72px) / 2;
        y: 146px;
        width: (parent.width - 72px) / 2;
        height: 40px;
        text <=> root.new-password;
        placeholder-text: "新密码";
        input-type: InputType.password;
    }

    Button {
        x: parent.width - 124px;
        y: 176px;
        width: 100px;
        height: 34px;
        text: "重设";
        clicked => { root.reset-password-requested(); }
    }

    Text {
        x: 24px;
        y: 190px;
        width: parent.width - 156px;
        text: root.status-text;
        color: #607052;
        font-size: 12px;
        wrap: word-wrap;
    }
}
