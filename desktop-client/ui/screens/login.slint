import { Button, LineEdit } from "std-widgets.slint";

export component LoginScreen inherits Rectangle {
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> verification-code;
    in property <string> status-text: "等待登录";

    callback login-requested();
    callback register-requested();
    callback verify-code-requested();

    height: 372px;
    background: #f8fbff;
    border-radius: 24px;
    border-color: #d7e4f0;
    border-width: 1px;

    Text {
        x: 24px;
        y: 20px;
        text: "登录与注册";
        color: #18324a;
        font-size: 24px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: "使用注册邮箱登录。需要注册时先发送邮箱验证码，再完成注册。";
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }

    Text { x: 24px; y: 98px; text: "邮箱"; color: #3a5570; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 118px;
        width: parent.width - 48px;
        height: 40px;
        text <=> root.email;
        placeholder-text: "name@example.com";
    }

    Text { x: 24px; y: 172px; text: "密码"; color: #3a5570; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 192px;
        width: parent.width - 48px;
        height: 40px;
        text <=> root.password;
        placeholder-text: "输入密码";
        input-type: InputType.password;
    }

    Text { x: 24px; y: 246px; text: "验证码 / 2FA"; color: #3a5570; font-size: 12px; font-weight: 700; }
    LineEdit {
        x: 24px;
        y: 266px;
        width: parent.width - 160px;
        height: 40px;
        text <=> root.verification-code;
        placeholder-text: "注册验证码或 2FA";
    }

    Button {
        x: parent.width - 120px;
        y: 266px;
        width: 96px;
        height: 40px;
        text: "发验证码";
        clicked => { root.verify-code-requested(); }
    }

    Button {
        x: 24px;
        y: 324px;
        width: 112px;
        height: 40px;
        text: "登录";
        clicked => { root.login-requested(); }
    }

    Button {
        x: 148px;
        y: 324px;
        width: 112px;
        height: 40px;
        text: "注册";
        clicked => { root.register-requested(); }
    }

    Rectangle {
        x: 280px;
        y: 320px;
        width: parent.width - 304px;
        height: 44px;
        background: #ffffff;
        border-radius: 14px;
        border-color: #d7e4f0;
        border-width: 1px;

        Text {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            text: root.status-text;
            color: #5b7490;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
