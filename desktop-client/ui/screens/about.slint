export component AboutScreen inherits Rectangle {
    background: #f8fbff;
    border-radius: 24px;
    border-color: #d7e4f0;
    border-width: 1px;

    Text {
        x: 24px;
        y: 18px;
        text: "隐私与连接原则";
        color: #18324a;
        font-size: 20px;
        font-weight: 800;
    }

    Text {
        x: 24px;
        y: 52px;
        width: parent.width - 48px;
        text: "客户端不展示普通连接密钥，不要求你复制服务地址。官方模式保持原样，平台代理模式使用独立受管运行目录。";
        color: #688097;
        font-size: 13px;
        wrap: word-wrap;
    }
}
